---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Generator from '../../components/Generator.astro';

const title = 'Pixel Papercraft Generator — Free Pixel Papercraft Designs';
const description = 'Generate retro pixel art papercraft designs with the free pixel papercraft generator. Describe a ghost, character, or idea and get an 8-bit AI-generated papercraft design.';
---

<BaseLayout title={title} description={description} ogType="website">
  <article class="container generator-page">
    <header class="generator-head reveal">
      <p class="eyebrow"><span class="label">Pixel Papercraft Generator</span></p>
      <h1>Generate pixel art papercraft</h1>
      <p class="lede">
        Blocky, retro forms for nostalgic game-inspired art. Describe an idea, pick the Pixel style, and generate a beautiful papercraft design for inspiration and creative exploration.
      </p>
    </header>

    <!-- Generator app (pre-set to the Pixel style) -->
    <Generator defaultStyle="pixel" defaultPrompt="a pixel heart" />

    <!-- SEO content -->
    <section class="gen-info reveal">
      <h2>What you can make in the Pixel style</h2>
      <p>
        The pixel papercraft generator is built for chunky 8-bit shapes — hearts, sprites, and
        retro icons. Tell it <strong>a pixel heart</strong>, <strong>a game character</strong>, or
        <strong>a blocky ghost</strong>, and it returns a retro papercraft-style design you can use for inspiration.
        Every design is original papercraft-style artwork with a nostalgic pixel look.
      </p>

      <h2>How to use a generated design</h2>
      <ol class="gen-steps">
        <li><strong>Describe</strong> an idea above (or just press Generate for a suggestion), then pick your preferred style.</li>
        <li><strong>Generate</strong> your papercraft design — the AI creates a unique papercraft-style artwork in seconds.</li>
        <li><strong>Save</strong> your favorite designs for personal reference, inspiration, or creative exploration.</li>
        <li><strong>Explore</strong> different styles and variations — the same idea renders differently in Cute, Low Poly, Pixel, or Fantasy.</li>
      </ol>

      <h2>Other styles to try</h2>
      <p>
        Want a different look? The same idea renders differently in
        <a href="/tools/cute/">Cute</a>, <a href="/tools/lowpoly/">Low Poly</a>, or
        <a href="/tools/fantasy/">Fantasy</a>. Browse them all on the
        <a href="/tools/">papercraft generators hub</a>.
      </p>

      <h2>Frequently asked questions</h2>
      <div class="gen-faq">
        <details>
          <summary>Is the pixel generator free?</summary>
          <p>Yes. Every pixel papercraft design is free to generate and download. No account required.</p>
        </details>
        <details>
          <summary>What file do I get?</summary>
          <p>You get a high-resolution papercraft design image, ready to save and reuse as inspiration.</p>
        </details>
        <details>
          <summary>Can I make 8-bit sprites?</summary>
          <p>Describe a heart, ghost, or game icon and the generator renders it as a retro papercraft-style artwork.</p>
        </details>
      </div>
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'koPaper Pixel Papercraft Generator',
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Free online tool to generate pixel papercraft-style designs from a text idea.',
  })}></script>
</BaseLayout>
