---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const papers = await getCollection('letter-paper', ({ data }) => !data.draft);
  return papers.map(p => ({
    params: { slug: p.slug },
    props: { paper: p },
  }));
}

const { paper } = Astro.props;
const { Content } = await paper.render();

const allPapers = (await getCollection('letter-paper', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const idx = allPapers.findIndex(p => p.slug === paper.slug);
const related = [...allPapers.slice(idx + 1), ...allPapers.slice(0, idx)]
  .filter(p => p.slug !== paper.slug)
  .slice(0, 4);

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: paper.data.title,
  description: paper.data.description,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@type': 'Organization', name: 'koPaper', url: Astro.site.href },
  publisher: { '@type': 'Organization', name: 'koPaper', url: Astro.site.href },
};
if (paper.data.updated) {
  articleSchema.datePublished = paper.data.updated;
  articleSchema.dateModified = paper.data.updated;
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site.href },
    { '@type': 'ListItem', position: 2, name: 'Letter Paper', item: new URL('/letter-paper/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: paper.data.title },
  ],
};
---

<BaseLayout
  title={`Free Printable ${paper.data.title}`}
  description={paper.data.description}
  ogType="article"

  >
  <article class="container" style="max-width:800px; padding-top:40px">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/letter-paper/">Letter Paper</a>
      <span>/</span>
      <span>{paper.data.title}</span>
    </nav>

    <h1 style="margin-bottom:12px">{paper.data.title}</h1>
    <p style="font-size:1.15rem; color:var(--text-muted); margin-bottom:24px">{paper.data.description}</p>
    <div style="display:flex; align-items:center; gap:12px; font-size:0.88rem; color:var(--text-muted); margin-bottom:28px; flex-wrap:wrap">
      <span style="display:flex; align-items:center; gap:7px">
        <span style="width:26px; height:26px; border-radius:50%; background:var(--warm); color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:0.68rem; font-weight:700">kP</span>
        <a href="/about/" style="color:var(--text); font-weight:600; text-decoration:none">koPaper Team</a>
      </span>
      {paper.data.updated && <><span style="color:var(--border)">•</span><span>Published ${paper.data.updated}</span></>}
      <span style="color:var(--border)">•</span>
      <span>3 min read</span>
    </div>

    <div class="tutorial-content">
      <Content />
    </div>

    <section style="margin-top:44px">
      <h2>Print settings for this sheet</h2>
      <p>
        Print at <strong>100% scale</strong> on A4 or US Letter — "fit to page" shifts the margins and
        makes handwritten lines drift. Use matte paper around 100–120 gsm if you write with a fountain
        pen; plain 80 gsm copier paper feathers and ghosts. Keep colour designs in colour, and give the
        ink a minute to dry before writing.
      </p>
      <p>
        To build a matching set, pair this sheet with the
        <a href="/printables/envelopes/">printable envelopes</a> or the
        <a href="/printables/stationery-set/">stationery set</a>, then browse the rest of the
        <a href="/letter-paper/">letter paper collection</a>.
      </p>
    </section>

    <section style="margin-top:44px">
      <h2>More letter paper designs</h2>
      <div class="grid-4" style="margin-top:18px">
        {related.map(p => (
          <a href={`/letter-paper/${p.slug}/`} class="craft-card card">
            <div class="card-emoji">{p.data.emoji}</div>
            <div class="card-body">
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
