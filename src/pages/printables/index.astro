---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CraftCard from '../../components/CraftCard.astro';

const items = (await getCollection('printables', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Free Printable Paper Crafts | Cards, Gift Tags & More | koPaper"
  description="This section is being refreshed. Meanwhile, turn any idea into a papercraft design with koPaper's free AI generator."

  noindex>
  <section class="hero container" style="padding-bottom:20px">
    <h1 class="reveal">Printables</h1>
    <p class="reveal">This section is being refreshed. Meanwhile, design your own papercraft with the free AI generator.</p>
  </section>

  <section class="section container" style="padding-top:20px">
    <div class="grid-4" style="margin-top:20px">
      {items.map(p => (
        <CraftCard
          href={`/printables/${p.slug}/`}
          emoji={p.data.emoji}
          title={p.data.title}
          description={p.data.description}
        />
      ))}
    </div>
  </section>
</BaseLayout>
