---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CraftCard from '../../components/CraftCard.astro';

const items = (await getCollection('printables', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Free Printable Paper Crafts | Cards, Gift Tags & More | koPaper"
  description="Free printable paper craft templates: greeting cards, gift tags, party decorations, coloring pages, and origami paper. Print at home in minutes."
>
  <section class="hero container" style="padding-bottom:20px">
    <h1 class="reveal">Printables</h1>
    <p class="reveal">Free, ready-to-print paper craft sheets. Pick a theme, print, and craft — no design skills needed.</p>
  </section>

  <section class="section container" style="padding-top:20px">
    <div class="grid-4" style="margin-top:20px">
      {items.map(p => (
        <CraftCard
          href={`/printables/${p.slug}/`}
          emoji={p.data.emoji}
          title={p.data.title}
          description={p.data.description}
        />
      ))}
    </div>
  </section>
</BaseLayout>
