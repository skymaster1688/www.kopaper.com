---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CraftCard from '../../components/CraftCard.astro';

export async function getStaticPaths() {
  const items = await getCollection('printables', ({ data }) => !data.draft);
  return items.map(p => ({
    params: { slug: p.slug },
    props: { item: p },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site.href },
    { '@type': 'ListItem', position: 2, name: 'Printables', item: new URL('/printables/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: item.data.title },
  ],
};

const allItems = await getCollection('printables', ({ data }) => !data.draft);
const related = allItems
  .filter(p => p.slug !== item.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.data.title,
  description: item.data.description,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<BaseLayout
  title={item.data.title}
  description={item.data.description}
  ogType="article"

  noindex>
  <article class="container" style="max-width:820px; padding-top:40px">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/printables/">Printables</a>
      <span>/</span>
      <span>{item.data.title}</span>
    </nav>

    <h1 style="margin-bottom:12px">{item.data.emoji} {item.data.title}</h1>
    <p style="font-size:1.15rem; color:var(--text-muted); margin-bottom:24px">{item.data.description}</p>

    <div class="template-actions reveal">
      <a href="/" class="btn btn-primary btn-large">Make your own</a>
      <a href="/templates/" class="btn btn-outline btn-large">Browse templates</a>
    </div>

    <div class="tutorial-content">
      <Content />
    </div>

    {related.length > 0 && (
      <section style="margin-top:50px; padding-top:36px; border-top:1px solid var(--border)">
        <h2 style="font-size:1.3rem; margin-bottom:20px">More Printables</h2>
        <div class="grid-3">
          {related.map(p => (
            <CraftCard
              href={`/printables/${p.slug}/`}
              emoji={p.data.emoji}
              title={p.data.title}
              description={p.data.description}
            />
          ))}
        </div>
      </section>
    )}
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <style is:global>
    .template-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      justify-content: center;
      margin: 24px 0 8px;
    }
    .tutorial-content { margin-top: 32px; }
    .tutorial-content h2 {
      font-size: 1.35rem;
      margin-top: 38px;
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }
    .tutorial-content h2:first-child { margin-top: 0; }
    .tutorial-content h3 { margin-top: 26px; font-size: 1.1rem; }
    .tutorial-content p { color: var(--text-muted); margin-bottom: 14px; }
    .tutorial-content ul, .tutorial-content ol { padding-left: 22px; margin-bottom: 18px; }
    .tutorial-content li { padding: 4px 0; color: var(--text-muted); }
    .tutorial-content a { color: var(--primary); text-decoration: underline; }
  </style>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
