---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CraftCard from '../../components/CraftCard.astro';

const guides = (await getCollection('learn', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Paper Craft Guides & Paper Basics | koPaper Learn"
  description="Learn the paper behind the crafts: best origami paper, paper sizes, types of paper, and how to choose the right sheet for every project."
>
  <section class="hero container" style="padding-bottom:20px">
    <h1 class="reveal">Learn</h1>
    <p class="reveal">The paper basics behind every fold and cut — what to use, why it matters, and how to get it right.</p>
  </section>

  <section class="section container" style="padding-top:20px">
    <div class="grid-4" style="margin-top:20px">
      {guides.map(g => (
        <CraftCard
          href={`/learn/${g.slug}/`}
          emoji={g.data.emoji}
          title={g.data.title}
          description={g.data.description}
        />
      ))}
    </div>
  </section>
</BaseLayout>
