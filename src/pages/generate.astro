---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegacyNotice from '../components/LegacyNotice.astro';
---

<BaseLayout
  title="Paper Craft Generator"
  description="koPaper's AI Papercraft Generator turns your ideas into beautiful papercraft-style designs. Describe an idea and generate unique artwork for inspiration and creative exploration."
  noindex
>
  <LegacyNotice
    badge="Now: AI Papercraft Generator"
    title="Paper Craft Generator"
    intro="Our paper craft generator has become the AI Papercraft Design Studio. Describe an idea, pick a style, and generate beautiful papercraft designs for inspiration, reference, and creative exploration."
    links={[
      { href: '/', label: 'Open the AI Papercraft Generator' },
      { href: '/origami/', label: 'Browse origami tutorials' },
      { href: '/', label: 'Back to home' },
    ]}
  />
</BaseLayout>
