---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CraftCard from '../components/CraftCard.astro';
import GalleryCard from '../components/GalleryCard.astro';
import Generator from '../components/Generator.astro';

const tutorials = (await getCollection('tutorials', ({ data }) => !data.draft && data.kind !== 'papercraft'))
  .sort((a, b) => a.data.order - b.data.order);

const featured = tutorials.filter(t => t.data.featured).slice(0, 4);
const beginners = tutorials.filter(t => t.data.difficulty === 'Easy').slice(0, 3);

const learnArticles = (await getCollection('learn', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// Gallery: AI-generated papercraft showcase, newest first (driven by `updated`).
const galleryItems = (await getCollection('gallery', ({ data }) => !data.draft && !data.noindex))
  .sort((a, b) => (b.data.updated || '').localeCompare(a.data.updated || ''))
  .slice(0, 4);

const faqs = [
  { q: 'What is koPaper?', a: 'koPaper is an AI papercraft design studio. Describe an idea and it generates beautiful papercraft-style designs for inspiration, creative exploration, and visual reference.' },
  { q: 'Is the AI generator free?', a: 'Yes — 100% free, no sign-up, no account needed. Generate as many designs as you like, in any of the four styles.' },
  { q: 'What styles can I choose?', a: 'Four visual styles: Cute, Low Poly, Pixel, and Fantasy. The same idea renders differently in each, so you can match the look to your project.' },
  { q: 'Can I save or reuse the designs?', a: 'Yes. Save your favorite designs and use them as creative reference, inspiration, or a starting point for your own paper project.' },
  { q: 'Do I need design skills or special paper?', a: 'No. The generator needs no design skills and no special equipment — it creates papercraft-style artwork you can view and save on screen. For hands-on folding, browse our origami tutorials.' },
  { q: 'Are these suitable for kids?', a: 'Yes. The generator needs no design skills at all, and easy tutorials are perfect for ages 6 plus with minimal adult help.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---

<BaseLayout
  title="3D Papercraft Generator — Free Papercraft Designs | koPaper"
  description="Free 3D papercraft generator — turn any idea into a papercraft design in seconds. Create animals, characters and fantasy papercraft, no sign-up needed."
>
  <!-- 1. Hero — full width, 3D wireframe bleeds edge to edge -->
  <section class="hero-line">
    <div class="persp" aria-hidden="true">
      <svg viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice">
        <g fill="none" style="stroke: var(--text)">
          <g stroke-width="1" opacity="0.08">
            <line x1="-200" y1="520" x2="820" y2="220"/>
            <line x1="80"   y1="520" x2="820" y2="220"/>
            <line x1="360"  y1="520" x2="820" y2="220"/>
            <line x1="640"  y1="520" x2="820" y2="220"/>
            <line x1="1000" y1="520" x2="820" y2="220"/>
            <line x1="1280" y1="520" x2="820" y2="220"/>
            <line x1="0" y1="520" x2="1200" y2="520"/>
            <line x1="0" y1="460" x2="1200" y2="460"/>
            <line x1="0" y1="410" x2="1200" y2="410"/>
            <line x1="0" y1="370" x2="1200" y2="370"/>
            <line x1="0" y1="338" x2="1200" y2="338"/>
            <line x1="0" y1="312" x2="1200" y2="312"/>
            <line x1="0" y1="292" x2="1200" y2="292"/>
          </g>
          <!-- warm wireframe cube: the single warm focus in the field -->
          <g style="stroke: var(--warm)" stroke-width="1.4" opacity="0.22">
            <rect x="820" y="300" width="120" height="120"/>
            <rect x="890" y="278" width="74" height="74"/>
            <line x1="820" y1="300" x2="890" y2="278"/>
            <line x1="940" y1="300" x2="964" y2="278"/>
            <line x1="940" y1="420" x2="964" y2="352"/>
            <line x1="820" y1="420" x2="890" y2="352"/>
          </g>
          <g stroke-width="1.3" opacity="0.16">
            <polygon points="160,440 280,410 400,440 280,468"/>
            <line x1="280" y1="410" x2="280" y2="335"/>
            <line x1="280" y1="335" x2="160" y2="440"/>
            <line x1="280" y1="335" x2="400" y2="440"/>
            <line x1="280" y1="335" x2="280" y2="468"/>
          </g>
          <g stroke-width="1.3" opacity="0.22">
            <line x1="90" y1="120" x2="170" y2="120"/><polygon points="170,120 160,116 160,124" style="fill: var(--text)" stroke="none"/>
            <line x1="90" y1="120" x2="90" y2="48"/><polygon points="90,48 86,58 94,58" style="fill: var(--text)" stroke="none"/>
            <line x1="90" y1="120" x2="140" y2="160"/><polygon points="140,160 130,155 135,146" style="fill: var(--text)" stroke="none"/>
          </g>
          <g font-family="JetBrains Mono, monospace" font-size="12" style="fill: var(--text)" opacity="0.30">
            <text x="176" y="116">X</text>
            <text x="80" y="42">Y</text>
            <text x="146" y="174">Z</text>
          </g>
        </g>
      </svg>
    </div>

    <div class="wrap hero-inner">
      <div class="left">
        <p class="eyebrow"><span class="label">AI Papercraft Generator</span></p>
        <h1 class="display">Create Your Own <span class="mark">Papercraft</span> with AI</h1>
        <p class="sub">Turn your ideas into beautiful papercraft designs.</p>
        <p class="sub">Describe anything below &mdash; the AI design generator runs right here on this page.</p>
      </div>

      <div class="right">
        <div class="hero-fox" aria-hidden="true">
          <img src="/assets/ai/hero-fox.png" alt="AI papercraft fox design" width="460" height="420" loading="eager" decoding="async">
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Generator />
  </div>

  <div class="wrap">
    <div class="stats">
      <div class="stat"><div class="n">01</div><div class="l">design / prompt</div></div>
      <div class="stat"><div class="n">04</div><div class="l">art styles</div></div>
      <div class="stat"><div class="n">100%</div><div class="l">free &middot; no sign-up</div></div>
      <div class="stat"><div class="n">&infin;</div><div class="l">ideas</div></div>
    </div>
  </div>

  <!-- 2b. AI Papercraft Generator focus (SEO) -->
  <div class="wrap">
    <section class="sec">
      <div class="sec-head">
        <span class="label">The generator</span>
        <h2 class="display">Meet the AI Papercraft Generator</h2>
        <p>The AI Papercraft Generator turns a short sentence into original papercraft-style designs for inspiration and creative exploration.</p>
      </div>
      <div class="gen-grid">
        <aside class="gen-visual" aria-label="A papercraft-style fox design">
          <img src="/assets/ai/gen-fox.jpg" alt="AI papercraft fox design" width="400" height="400" loading="lazy" decoding="async">
        </aside>
        <div class="gen-copy">
          <p>Type an idea like <em>a cute dragon</em> or <em>a low poly castle</em>, and the AI Papercraft Generator returns a custom papercraft design in your chosen style. Each one is rendered as a beautiful papercraft-style artwork — perfect for inspiration, reference, and creative exploration. No design skills needed.</p>
          <p>Want paper art, character designs, or unique visual concepts? The papercraft generator helps you create designs that match your own idea instead of copying someone else's. Pick Cute, Low Poly, Pixel, or Fantasy, then generate, refine, and save your favorite designs.</p>
          <h3>Why use an AI papercraft generator?</h3>
          <p>A papercraft design generator is fastest when you already know what you want but cannot draw it. Describe the subject, set the style, and let the AI handle the artwork. You stay in control of the idea; the generator handles the rendering, so you can move from thought to visual in seconds.</p>
          <p class="gen-cta"><a class="btn btn-primary" href="/tools/">Browse style generators &rarr;</a></p>
        </div>
      </div>
    </section>
  </div>

  <!-- 2. How it works -->
  <div class="wrap">
    <section class="sec">
      <div class="sec-head">
        <span class="label">How it works</span>
        <h2 class="display">From idea to design in three steps</h2>
        <p>No design skills needed, no software to install. Just describe and create.</p>
      </div>
      <div class="steps">
        <div class="step"><div class="idx">01 &mdash; INPUT</div><h3>Describe</h3><p>Type what you imagine &mdash; a fox, a castle, a gift box. Pick a style if you like.</p></div>
        <div class="step"><div class="idx">02 &mdash; RENDER</div><h3>Generate</h3><p>koPaper draws an original papercraft design you can preview instantly.</p></div>
        <div class="step"><div class="idx">03 &mdash; EXPLORE</div><h3>Get Inspired</h3><p>Save your favorite designs, use them as creative reference, or try new styles and ideas. Your imagination is the limit.</p></div>
      </div>
    </section>

    <!-- 2c. Gallery: real AI-generated designs -->
    {galleryItems.length > 0 && (
      <section class="sec">
        <div class="sec-head">
          <span class="label">Gallery</span>
          <h2 class="display">Fresh from the generator</h2>
          <p>Papercraft designs created with the AI generator — explore, get inspired, and create your own.</p>
        </div>
        <div class="grid-4">
          {galleryItems.map(g => (
            <GalleryCard
              href={`/gallery/${g.slug}/`}
              title={g.data.title}
              description={g.data.description}
              body={g.body}
              emoji={g.data.emoji}
            />
          ))}
        </div>
        <div class="reveal" style="text-align:center; margin-top:28px">
          <a href="/gallery/" class="btn btn-outline">View all designs</a>
        </div>
      </section>
    )}

    <!-- 3. Explore pillars -->
    <section class="sec">
      <div class="sec-head">
        <span class="label">Explore</span>
        <h2 class="display">Start from a crafted starting point</h2>
        <p>Pick a style, browse real designs, or follow a guided paper craft.</p>
      </div>
      <div class="explore">
        <a href="/tools/" class="ecard">
          <div class="top"><span class="fig">FIG. A</span><span class="fig">STYLE</span></div>
          <div class="body"><h3>Style Generators</h3><p>Four visual styles — Cute, Low Poly, Pixel &amp; Fantasy. Pick one and generate.</p><span class="go">Browse <span class="ar"></span></span></div>
        </a>
        <a href="/gallery/" class="ecard">
          <div class="top"><span class="fig">FIG. B</span><span class="fig">GALLERY</span></div>
          <div class="body"><h3>Gallery</h3><p>Real AI-generated papercraft designs from real ideas.</p><span class="go">Explore <span class="ar"></span></span></div>
        </a>
        <a href="/origami/" class="ecard">
          <div class="top"><span class="fig">FIG. C</span><span class="fig">MAKE</span></div>
          <div class="body"><h3>Tutorials</h3><p>Step-by-step origami and paper crafts for all ages.</p><span class="go">Browse <span class="ar"></span></span></div>
        </a>
        <a href="/learn/" class="ecard">
          <div class="top"><span class="fig">FIG. D</span><span class="fig">LEARN</span></div>
          <div class="body"><h3>Learn</h3><p>Paper basics &amp; guides — how to choose the right sheet for every project.</p><span class="go">Browse <span class="ar"></span></span></div>
        </a>
      </div>
    </section>

    <!-- 4. Beginner tutorials (SEO entry) -->
    {beginners.length > 0 && (
      <section class="sec">
        <div class="sec-head">
          <span class="label">Getting started</span>
          <h2 class="display">Start with a tutorial</h2>
          <p>Easy paper crafts for your very first project.</p>
        </div>
        <div class="grid-3">
          {beginners.map(t => (
            <CraftCard
              href={`/origami/${t.slug}/`}
              emoji={t.data.emoji}
              title={t.data.title}
              description={t.data.description}
              difficulty={t.data.difficulty}
              time={t.data.time}
            />
          ))}
        </div>
      </section>
    )}

    <!-- 5. Popular crafts (SEO entry) -->
    {featured.length > 0 && (
      <section class="sec">
        <div class="sec-head">
          <span class="label">Most loved</span>
          <h2 class="display">Popular paper crafts</h2>
          <p>Most-loved tutorials from Easy to Hard.</p>
        </div>
        <div class="grid-4">
          {featured.map(t => (
            <CraftCard
              href={`/origami/${t.slug}/`}
              emoji={t.data.emoji}
              title={t.data.title}
              description={t.data.description}
              difficulty={t.data.difficulty}
              time={t.data.time}
            />
          ))}
        </div>
        <div class="reveal" style="text-align:center; margin-top:28px">
          <a href="/origami/" class="btn btn-outline">View all crafts</a>
        </div>
      </section>
    )}

    <!-- 6b. Learn guides (SEO entry) -->
    {learnArticles.length > 0 && (
      <section class="sec">
        <div class="sec-head">
          <span class="label">Learn</span>
          <h2 class="display">Paper guides &amp; basics</h2>
          <p>The paper behind every craft — what to use, why it matters, and how to choose right.</p>
        </div>
        <div class="grid-4">
          {learnArticles.slice(0, 4).map(g => (
            <CraftCard
              href={`/learn/${g.slug}/`}
              emoji={g.data.emoji}
              title={g.data.title}
              description={g.data.description}
            />
          ))}
        </div>
        <div class="reveal" style="text-align:center; margin-top:28px">
          <a href="/learn/" class="btn btn-outline">View all guides</a>
        </div>
      </section>
    )}

    <!-- 7. FAQ -->
    <section class="sec">
      <div class="sec-head">
        <span class="label">FAQ</span>
        <h2 class="display">Frequently Asked Questions</h2>
        <p>Everything you need to know to get started.</p>
      </div>
      <div class="reveal">
        {faqs.map(f => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- 8. CTA -->
    <section class="cta">
      <div>
        <h2 class="display">What will you create?</h2>
        <p>Open the studio and turn your first idea into papercraft.</p>
      </div>
      <a href="/tools/" class="btn btn-onwarm">Browse style generators &rarr;</a>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

</BaseLayout>
