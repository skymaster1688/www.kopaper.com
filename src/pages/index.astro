          {TUTORIAL_CARDS.map(t => (
            <a class="cl-card" href={t.href}>
              <span class="cl-emoji">{t.emoji}</span>
              <div class="cl-body"><h3>{t.title}</h3><p>{t.meta}</p></div>
              <span class="cl-arrow">→</span>
            </a>
          ))}
          <a class="cl-card cl-guide" href={LEARN_CARD.href}>
            <span class="cl-emoji">{LEARN_CARD.emoji}</span>
            <div class="cl-body"><h3>{LEARN_CARD.title}</h3><p>{LEARN_CARD.meta}</p></div>
            <span class="cl-arrow">→</span>
          </a>
        </div>
      </section>

      <section class="home-faq" id="faq">
        <div class="section-kicker">GOOD TO KNOW</div>
        <div class="section-heading"><h2>AI papercraft generator FAQ</h2></div>
        <div class="faq-list">
          {faqs.map(f => (
            <details><summary>{f.q}</summary><p>{f.a}</p></details>
          ))}
        </div>
      </section>
    </main>

    <!-- Ad slot (third-party network): filled after consent -->
    <div id="container-04bba4fddad31c9c102b34f4c1c7ad04" style="margin:28px auto;max-width:1200px;min-height:90px;display:flex;align-items:center;justify-content:center;padding:0 20px;box-sizing:border-box;"></div>

