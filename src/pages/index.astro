---
// koPaper homepage — concept design from kopaper-homepage/, wired to real data:
// real gallery collection, real style chips, real /api/generate-image endpoint,
// real internal links. Self-contained layout (does not use BaseLayout).
import { getCollection } from 'astro:content';
import { detectSubject } from '../lib/gallery';
import '../styles/homepage.css';

const title = 'Free AI Papercraft Generator - Create Paper Art';
const description = 'Use our free AI papercraft generator to turn any idea into papercraft-style art. Choose cute, low poly, pixel, fantasy and more styles - no sign-up needed.';

const CAT_LABEL: Record<string, string> = { animal: 'Animals', dragon: 'Dragons', vehicle: 'Vehicles', building: 'Buildings' };
const STYLE_LABEL: Record<string, string> = { lowpoly: 'Low Poly', cute: 'Cute', pixel: 'Pixel', fantasy: 'Fantasy', minecraft: 'Blocky Voxel' };
const TONES = ['mint', 'blue', 'peach', 'lemon', 'sky', 'pink'];

function promptOf(d: any): string {
  const m = (d.description || '').match(/"([^"]+)"/);
  return m ? m[1] : (d.title || '');
}

const indexed = (await getCollection('gallery', ({ data }) => !data.draft && !data.noindex))
  .sort((a, b) => (b.data.updated || '').localeCompare(a.data.updated || ''));

type Card = { title: string; href: string; img: string; prompt: string; cat: string; tag: string; tone: string };
const cards: Card[] = [];
const seen = new Set<string>();
const perCat = new Map<string, number>();
// Prefer the four subjects that have dedicated category pages, then top up with the rest.
// Cap each subject at 2 cards so the grid stays visually varied.
for (const pass of [true, false]) {
  for (const g of indexed) {
    if (cards.length >= 6) break;
    if (seen.has(g.slug)) continue;
    const imgMatch = (g.body || '').match(/!\[[^\]]*\]\(([^)]+)\)/);
    if (!imgMatch) continue;
    const prompt = promptOf(g.data);
    const { category } = detectSubject(prompt);
    const inCat = !!CAT_LABEL[category];
    if (pass !== inCat) continue;
    const used = perCat.get(category) || 0;
    if (used >= (pass ? 1 : 2)) continue;
    seen.add(g.slug);
    perCat.set(category, used + 1);
    cards.push({
      title: g.data.title,
      href: `/gallery/${g.slug}/`,
      img: imgMatch[1],
      prompt,
      cat: CAT_LABEL[category] || 'Ideas',
      tag: STYLE_LABEL[g.data.style] || 'Cute',
      tone: TONES[cards.length % TONES.length],
    });
  }
}
const categories = ['All', 'Animals', 'Dragons', 'Vehicles', 'Buildings'];

// Module 03 — five style entries, each with its own generator page.
const STYLES = [
  { name: 'Cute Papercraft', desc: 'Round shapes, kawaii characters and animals.', href: '/tools/cute/', emoji: '🐼', tone: 'mint' },
  { name: 'Low Poly Papercraft', desc: 'Geometric facets and modern paper art.', href: '/tools/lowpoly/', emoji: '🦊', tone: 'blue' },
  { name: 'Pixel Papercraft', desc: 'Retro pixel-inspired paper designs.', href: '/tools/pixel/', emoji: '❤️', tone: 'peach' },
  { name: 'Fantasy Papercraft', desc: 'Dragons, castles and magical creatures.', href: '/tools/fantasy/', emoji: '🐉', tone: 'lilac' },
  { name: 'Blocky Papercraft', desc: 'Voxel cube builds, one block at a time.', href: '/tools/blocky/', emoji: '🧊', tone: 'lemon' },
];

// Module 06/07 — curated hands-on tutorials + one knowledge guide (deduped:
// tutorials teach HOW to fold, the guide teaches WHICH materials).
const TUTORIAL_CARDS = [
  { title: 'How to Make a Paper Airplane', href: '/origami/airplane/', emoji: '✈️', meta: 'Easy · 5 minutes' },
  { title: 'How to Make an Origami Heart', href: '/origami/heart/', emoji: '❤️', meta: 'Easy · 5 minutes' },
  { title: 'How to Make an Easy Paper Butterfly', href: '/origami/butterfly/', emoji: '🦋', meta: 'Easy · 8 minutes' },
];
const LEARN_CARD = { title: 'Best Origami Paper for Beginners', href: '/learn/best-origami-paper/', emoji: '📄', meta: 'Paper guide · kami vs washi vs foil' };

const quickPrompts = ['A cute baby panda', 'A low poly fox', 'A fantasy castle', 'A pixel art heart'];

const faqs = [
  { q: 'What is koPaper?', a: 'koPaper is an AI papercraft design studio. Describe an idea and it generates beautiful papercraft-style designs you can use for inspiration, creative exploration, and visual reference.' },
  { q: 'Is the AI papercraft generator free?', a: 'Yes — 100% free, no sign-up, no account needed. Generate as many designs as you like, in any of the five styles.' },
  { q: 'What styles can the AI papercraft generator create?', a: 'Five distinct looks: Cute & Kawaii for round, friendly characters; Low Poly for geometric, faceted animals; Pixel for retro game-inspired art; Fantasy for dragons and castles; and Blocky Voxel for cube-built designs. Each style also has its own dedicated generator page.' },
  { q: 'How does the generator work?', a: 'Type a short description of what you want — a sleepy cat, a castle on a hill, a rocket ship — then pick a style and detail level. The AI renders your idea as papercraft-style artwork in seconds, usually with several variations to choose from.' },
  { q: 'Can I print the designs?', a: 'Yes. Every design can be downloaded and printed at home. Keep in mind the results are papercraft-style artwork — illustrations of what your idea would look like as a paper model — rather than cut-and-fold templates. For ready-to-print templates, visit our printables section.' },
  { q: 'Do I need design skills or special paper?', a: 'No. The generator needs no design skills and no special equipment — it creates papercraft-style artwork you can view and save on screen. For hands-on folding, browse our origami tutorials.' },
  { q: 'Can I use the designs in my own projects?', a: 'Absolutely. Save your favorite designs and use them as creative reference, party decorations, classroom activities, or a starting point for your next paper craft project. If you make something wonderful, our gallery of community designs is a great place to find even more inspiration.' },
  { q: 'Can I save the designs?', a: 'Yes. Save your favorite generated designs and use them as creative reference, inspiration, or a starting point for your own paper project.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'koPaper', url: 'https://kopaper.com/' },
    { '@type': 'Organization', name: 'koPaper', url: 'https://kopaper.com/', logo: 'https://kopaper.com/images/favicon-32x32.png' },
    {
      '@type': 'WebApplication', name: 'koPaper AI Papercraft Generator',
      url: 'https://kopaper.com/#generator', applicationCategory: 'DesignApplication',
      operatingSystem: 'Web', browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};

const GA_ID = 'G-QVKPRKCBW8';
const ADSENSE_ID = 'ca-pub-6279178382144076';
const year = new Date().getFullYear();
