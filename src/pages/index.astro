            <div class="prompt-footer"><span><span class="tiny-sparkle">✦</span> Be as imaginative as you like</span><span id="char-count">0 / 400</span></div>
            <div class="quick-prompts" aria-label="Quick prompt ideas"><span class="qp-label">Try:</span>{quickPrompts.map(q => <button class="quick-prompt" type="button" data-quick={q}>{q}</button>)}</div>
            <div class="generator-options">
              <div><label class="field-label" for="style">Choose a paper style</label><select id="style"><option>Low Poly</option><option>Cute &amp; Kawaii</option><option>Blocky Voxel</option><option>Pixel Papercraft</option><option>Fantasy 3D</option></select></div>
              <div><label class="field-label" for="complexity">Detail level</label><select id="complexity"><option>Simple</option><option selected>Balanced</option><option>Highly Detailed</option></select></div>
            </div>
            <button class="button generate-button" id="generate">✦ Generate Papercraft <span>→</span></button>
            <div class="generator-results" id="results" aria-live="polite"></div>
