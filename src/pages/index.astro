---
// koPaper homepage — concept design from kopaper-homepage/, wired to real data:
// real gallery collection, real style chips, real /api/generate-image endpoint,
// real internal links. Self-contained layout (does not use BaseLayout).
import { getCollection } from 'astro:content';
import { detectSubject } from '../lib/gallery';
import '../styles/homepage.css';

const title = 'AI Papercraft Generator - Create Your Own Paper Art';
const description = "Turn your ideas into papercraft designs with koPaper's free AI papercraft generator. Explore styles, browse real designs, and start making something wonderful.";

const CAT_LABEL: Record<string, string> = { animal: 'Animals', dragon: 'Dragons', vehicle: 'Vehicles', building: 'Buildings' };
const STYLE_LABEL: Record<string, string> = { lowpoly: 'Low Poly', cute: 'Cute', pixel: 'Pixel', fantasy: 'Fantasy', minecraft: 'Blocky Voxel' };
const TONES = ['mint', 'blue', 'peach', 'lemon', 'sky', 'pink'];

function promptOf(d: any): string {
  const m = (d.description || '').match(/"([^"]+)"/);
  return m ? m[1] : (d.title || '');
}

const indexed = (await getCollection('gallery', ({ data }) => !data.draft && !data.noindex))
  .sort((a, b) => (b.data.updated || '').localeCompare(a.data.updated || ''));

type Card = { title: string; href: string; img: string; prompt: string; cat: string; tag: string; tone: string };
const cards: Card[] = [];
const seen = new Set<string>();
const perCat = new Map<string, number>();
// Prefer the four subjects that have dedicated category pages, then top up with the rest.
// Cap each subject at 2 cards so the grid stays visually varied.
for (const pass of [true, false]) {
  for (const g of indexed) {
    if (cards.length >= 6) break;
    if (seen.has(g.slug)) continue;
    const imgMatch = (g.body || '').match(/!\[[^\]]*\]\(([^)]+)\)/);
    if (!imgMatch) continue;
    const prompt = promptOf(g.data);
    const { category } = detectSubject(prompt);
    const inCat = !!CAT_LABEL[category];
    if (pass !== inCat) continue;
    const used = perCat.get(category) || 0;
    if (used >= (pass ? 1 : 2)) continue;
    seen.add(g.slug);
    perCat.set(category, used + 1);
    cards.push({
      title: g.data.title,
      href: `/gallery/${g.slug}/`,
      img: imgMatch[1],
      prompt,
      cat: CAT_LABEL[category] || 'Ideas',
      tag: STYLE_LABEL[g.data.style] || 'Cute',
      tone: TONES[cards.length % TONES.length],
    });
  }
}
const categories = ['All', 'Animals', 'Dragons', 'Vehicles', 'Buildings'];

const faqs = [
  { q: 'What is koPaper?', a: 'koPaper is an AI papercraft design studio. Describe an idea and it generates beautiful papercraft-style designs you can use for inspiration, creative exploration, and visual reference.' },
  { q: 'Is the AI papercraft generator free?', a: 'Yes — 100% free, no sign-up, no account needed. Generate as many designs as you like, in any of the five styles.' },
  { q: 'Can I save the designs?', a: 'Yes. Save your favorite generated designs and use them as creative reference, inspiration, or a starting point for your own paper project.' },
  { q: 'Do I need design skills or special paper?', a: 'No. The generator needs no design skills and no special equipment — it creates papercraft-style artwork you can view and save on screen. For hands-on folding, browse our origami tutorials.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const GA_ID = 'G-QVKPRKCBW8';
const ADSENSE_ID = 'ca-pub-6279178382144076';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fffaf4" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://kopaper.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://kopaper.com/" />
    <meta property="og:site_name" content="koPaper" />
    <meta property="og:image" content="https://kopaper.com/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/images/android-chrome-512x512.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        analytics_storage: 'denied', functionality_storage: 'granted',
        personalization_storage: 'denied', security_storage: 'granted',
      });
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="koPaper home"><img class="brand-mark" src="/images/favicon-32x32.png" alt="" width="22" height="22"><span>koPaper</span></a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="#generator">AI Generator</a><a href="/gallery/">Gallery</a><a href="/learn/">Tutorials</a><a href="/printables/">Templates</a><a href="/about/">About</a>
      </nav>
      <div class="header-actions"><a class="search-link" href="/gallery/">⌕ <span>Explore papercraft...</span></a><a class="button button-small" href="#generator">Start Creating <span>↗</span></a><button class="menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button></div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-dot"></span> YOUR IDEAS, MADE OF PAPER</div>
          <h1>AI Papercraft<br /><span>Generator</span></h1>
          <p class="hero-text">Turn your ideas into amazing paper art. Create, customize and bring paper to life!</p>
          <div class="hero-actions"><a class="button" href="#generator">✦ Generate Now <span>→</span></a><a class="text-button" href="#gallery">Explore Gallery <span>↓</span></a></div>
        </div>
        <div class="hero-art" aria-label="Low-poly paper fox design generated with koPaper" role="img">
          <div class="sun"></div><div class="cloud cloud-one"></div>
          <img class="hero-photo" src="/images/gallery/low-poly-fox-papercraft-design-ai-generated-mtjdm8d1ous3.jpg" alt="Low poly papercraft fox design generated with the koPaper AI papercraft generator" loading="eager" fetchpriority="high" />
          <div class="sparkle sparkle-one">✦</div><div class="sparkle sparkle-two">✧</div>
          <div class="art-note"><span>✂</span><div><b>Dream it. Fold it.</b><small>Make it yours.</small></div></div>
        </div>
      </section>

      <section class="generator-wrap" id="generator">
        <div class="section-kicker">THE CREATIVE PLAYGROUND</div>
        <div class="section-heading"><h2>Your next paper project<br class="mobile-break" /> starts here.</h2><p>Describe your idea. Pick a style. Let your imagination take shape.</p></div>
        <div class="generator-card">
          <div class="generator-main">
            <label class="field-label" for="idea">What would you like to create?</label>
            <textarea id="idea" maxlength="400" placeholder="A tiny orange fox sitting in a flower garden, made from folded paper... "></textarea>
            <div class="prompt-footer"><span><span class="tiny-sparkle">✦</span> Be as imaginative as you like</span><span id="char-count">0 / 400</span></div>
            <div class="generator-options">
              <div><label class="field-label" for="style">Choose a paper style</label><select id="style"><option>Low Poly</option><option>Cute &amp; Kawaii</option><option>Blocky Voxel</option><option>Pixel Papercraft</option><option>Fantasy 3D</option></select></div>
              <div><label class="field-label" for="complexity">Detail level</label><select id="complexity"><option>Simple</option><option selected>Balanced</option><option>Highly Detailed</option></select></div>
            </div>
            <button class="button generate-button" id="generate">✦ Generate Papercraft <span>→</span></button>
            <div class="generator-results" id="results" aria-live="polite"></div>
            <p class="generator-status" id="generator-status" role="status">Your first creation is just a few words away.</p>
          </div>
          <div class="generator-aside"><div class="aside-art"><div class="paper-sun"></div><div class="paper-flower">🌼</div><div class="paper-hill"></div><div class="paper-hill second"></div><div class="paper-butterfly">🦋</div></div><h3>A blank page full of possibilities.</h3><p>Start with a simple idea. You can refine your prompt and explore different looks as you go.</p><span class="aside-tip">IDEA TIP <b>Try “a sleepy cat in a teacup”</b></span></div>
        </div>
      </section>

      <section class="feature-strip" aria-label="What you can explore">
        <a class="feature" href="/papercraft-ideas/"><span class="feature-icon purple">✦</span><div><b>AI-Powered</b><p>Turn text or ideas into papercraft designs</p></div></a>
        <a class="feature" href="/gallery/"><span class="feature-icon lilac">📖</span><div><b>Rich Gallery</b><p>Discover thousands of paper creations</p></div></a>
        <a class="feature" href="/learn/"><span class="feature-icon peach">✂️</span><div><b>Easy Tutorials</b><p>Learn step-by-step with simple guides</p></div></a>
        <a class="feature" href="/printables/"><span class="feature-icon blue">⤓</span><div><b>Free Templates</b><p>Get printable templates and start crafting</p></div></a>
      </section>

      <section class="gallery-section" id="gallery">
        <div class="section-top"><div><div class="section-kicker">A WORLD OF PAPER POSSIBILITIES</div><h2>Popular Papercraft Creations</h2><p>Explore our latest AI-generated designs and community favorites.</p></div><a class="text-button desktop-only" href="/gallery/">View All <span>→</span></a></div>
        <div class="category-list" role="group" aria-label="Filter gallery">{categories.map((category, i) => <button class:list={["category-chip", { active: i === 0 }]} data-category={category}>{category}</button>)}</div>
        <div class="gallery-grid" id="gallery-grid">
          {cards.map((item) => (
            <article class="gallery-card" data-kind={item.cat}>
              <a href="#generator" class:list={["gallery-image", item.tone]} data-prompt={item.prompt} aria-label={`Try this idea: ${item.prompt}`}>
                <img src={item.img} alt={item.title} loading="lazy" />
                <span class="card-tag">{item.tag}</span>
                <span class="view-overlay">Try this idea ↗</span>
              </a>
              <div class="gallery-meta"><div><h3><a href={item.href}>{item.title}</a></h3><span>{item.cat}</span></div><span class="likes">♡ AI made</span></div>
            </article>
          ))}
        </div>
      </section>

      <section class="template-banner" id="journey"><div class="banner-illustration">🕊️<span>✦</span></div><div><span class="section-kicker">READY, SET, CREATE</span><h2>Start Your Papercraft<br />Journey Today</h2><p>With kopaper.com, the only limit is your imagination.</p><a class="button" href="#generator">Try AI Generator <span>→</span></a></div><div class="banner-decoration">✳</div></section>

      <section class="how-section" id="how-it-works"><div class="how-intro"><div class="section-kicker">FROM IDEA TO PAPER ART</div><h2>Creativity, in<br />three little steps.</h2><p>No fancy tools or design skills needed to get started. Just bring an idea.</p><a class="text-button" href="#generator">Give it a try <span>→</span></a></div><div class="steps"><article class="step"><span class="step-number">01</span><div class="step-icon">💭</div><h3>Imagine it</h3><p>Describe the creature, object, or scene you want to bring to life.</p></article><article class="step"><span class="step-number">02</span><div class="step-icon">🎨</div><h3>Pick your style</h3><p>Explore playful looks, from low-poly shapes to blocky voxel builds.</p></article><article class="step"><span class="step-number">03</span><div class="step-icon">✂️</div><h3>Make it yours</h3><p>Use your design as inspiration for your next paper craft project.</p></article></div></section>

      <section class="home-faq" id="faq">
        <div class="section-kicker">GOOD TO KNOW</div>
        <div class="section-heading"><h2>Frequently asked questions</h2></div>
        <div class="faq-list">
          {faqs.map(f => (
            <details><summary>{f.q}</summary><p>{f.a}</p></details>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer"><a class="brand" href="/"><img class="brand-mark" src="/images/favicon-32x32.png" alt="" width="22" height="22"><span>koPaper</span></a><p>Craft a more creative world.</p><div class="footer-links"><a href="/gallery/">Gallery</a><a href="/learn/">Tutorials</a><a href="/printables/">Templates</a><a href="/origami/">Origami</a><a href="/contact/">Contact</a></div><small>© 2026 kopaper.com. Made for curious creators.</small></footer>

    <!-- Ad slot (third-party network): filled after consent -->
    <div id="container-04bba4fddad31c9c102b34f4c1c7ad04" style="margin:28px auto;max-width:1200px;min-height:90px;display:flex;align-items:center;justify-content:center;padding:0 20px;box-sizing:border-box;"></div>

    <!-- Cookie consent banner (GDPR): GA4 + AdSense load only after consent -->
    <div id="consentBanner" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:200;background:#fff;border-top:1px solid var(--line);padding:14px 20px;font-size:.85rem;color:var(--ink);box-shadow:0 -8px 30px rgba(48,35,66,.08);">
      <div style="max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
        <span>We use cookies for analytics and to show relevant ads. <a href="/privacy/" style="color:var(--purple);text-decoration:underline;">Privacy</a></span>
        <div style="display:flex;gap:10px;">
          <button id="consentDecline" style="padding:8px 14px;border:1px solid var(--line);border-radius:30px;background:#fff;color:var(--ink);cursor:pointer;">Decline</button>
          <button id="consentAccept" style="padding:8px 14px;border:none;border-radius:30px;background:var(--purple);color:#fff;cursor:pointer;">Accept</button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ GA_ID, ADSENSE_ID }}>
      (function() {
        const KEY = 'koPaper_consent';
        let stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}
        function loadThirdParty() {
          const s1 = document.createElement('script');
          s1.async = true;
          s1.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s1);
          gtag('js', new Date());
          gtag('config', GA_ID);
          const s2 = document.createElement('script');
          s2.async = true;
          s2.crossOrigin = 'anonymous';
          s2.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + ADSENSE_ID;
          document.head.appendChild(s2);
          const s3 = document.createElement('script');
          s3.setAttribute('data-cfasync', 'false');
          s3.src = 'https://pl31324343.profitableratecpmnetwork.com/04bba4fddad31c9c102b34f4c1c7ad04/invoke.js';
          document.head.appendChild(s3);
        }
        function decide(v) {
          try { localStorage.setItem(KEY, v); } catch (e) {}
          if (v === 'granted') {
            gtag('consent', 'update', {
              ad_storage: 'granted', ad_user_data: 'granted',
              ad_personalization: 'granted', analytics_storage: 'granted',
            });
            loadThirdParty();
          }
          const b = document.getElementById('consentBanner');
          if (b) b.style.display = 'none';
        }
        if (stored === 'granted') {
          loadThirdParty();
        } else if (stored !== 'denied') {
          document.getElementById('consentBanner').style.display = 'block';
          document.getElementById('consentAccept').addEventListener('click', () => decide('granted'));
          document.getElementById('consentDecline').addEventListener('click', () => decide('denied'));
        }
      })();
    </script>

    <script>
      // --- prompt box ---
      const idea = document.querySelector('#idea') as HTMLTextAreaElement;
      const count = document.querySelector('#char-count')!;
      const status = document.querySelector('#generator-status')!;
      const results = document.querySelector('#results') as HTMLElement;
      const generateBtn = document.querySelector('#generate') as HTMLButtonElement;
      idea.addEventListener('input', () => count.textContent = `${idea.value.length} / 400`);

      // --- real generation via /api/generate-image ---
      const STYLE_IDS: Record<string, string> = {
        'Low Poly': 'lowpoly', 'Cute & Kawaii': 'cute', 'Blocky Voxel': 'minecraft',
        'Pixel Papercraft': 'pixel', 'Fantasy 3D': 'fantasy',
      };
      const DETAIL: Record<string, string> = {
        'Simple': 'simple clean shapes, minimal detail',
        'Balanced': '',
        'Highly Detailed': 'highly detailed, intricate paper craftsmanship',
      };

      async function generate() {
        const ideaVal = idea.value.trim();
        if (!ideaVal) {
          status.textContent = 'Add a little description first — anything you can imagine!';
          idea.focus();
          return;
        }
        const styleSel = document.querySelector('#style') as HTMLSelectElement;
        const detailSel = document.querySelector('#complexity') as HTMLSelectElement;
        const styleId = STYLE_IDS[styleSel.value] || 'cute';
        const suffix = DETAIL[detailSel.value] || '';
        const prompt = [ideaVal, suffix].filter(Boolean).join(', ');

        generateBtn.disabled = true;
        status.textContent = 'Folding your paper idea… this can take up to a minute.';
        results.classList.remove('show');
        results.innerHTML = '';
        const payload = JSON.stringify({ prompt, style: styleId });
        const headers = { 'Content-Type': 'application/json' };
        let data: any;
        try {
          const res = await fetch('/api/generate-image', { method: 'POST', headers, body: payload });
          if (!res.ok) throw new Error('route unavailable');
          data = await res.json();
        } catch (routeErr) {
          // Local preview / static host has no SSR route — fall back to the
          // production endpoint (its CORS allowlist covers localhost:4321).
          const res = await fetch('https://kopaper.com/api/generate-image', { method: 'POST', headers, body: payload });
          data = await res.json();
        }
        try {
          if (!data || !data.ok || !Array.isArray(data.images) || data.images.length === 0) throw new Error('no images');
          for (const img of data.images) {
            const el = document.createElement('img');
            el.src = `data:${img.mediaType || 'image/png'};base64,${img.b64}`;
            el.alt = `AI-generated papercraft design of ${ideaVal}`;
            el.loading = 'lazy';
            results.appendChild(el);
          }
          results.classList.add('show');
          status.textContent = 'Here it is! Save the ones you like, or tweak the idea and generate again.';
        } catch (e) {
          status.innerHTML = 'The generator is taking a break right now. Try again in a moment, or browse the <a href="/gallery/" style="color:var(--purple);text-decoration:underline;">gallery</a> for inspiration.';
        } finally {
          generateBtn.disabled = false;
        }
      }
      generateBtn.addEventListener('click', generate);

      // --- gallery category filter ---
      document.querySelectorAll<HTMLButtonElement>('.category-chip').forEach(button => button.addEventListener('click', () => {
        document.querySelectorAll('.category-chip').forEach(item => item.classList.remove('active'));
        button.classList.add('active');
        const category = button.dataset.category;
        document.querySelectorAll<HTMLElement>('.gallery-card').forEach(card => card.hidden = category !== 'All' && card.dataset.kind !== category);
      }));

      // --- "Try this idea" fills the prompt box ---
      document.querySelectorAll<HTMLAnchorElement>('.gallery-image[data-prompt]').forEach(link => link.addEventListener('click', (ev) => {
        ev.preventDefault();
        idea.value = link.dataset.prompt || '';
        idea.dispatchEvent(new Event('input'));
        document.querySelector('#generator')!.scrollIntoView({ behavior: 'smooth' });
        setTimeout(() => idea.focus({ preventScroll: true }), 450);
      }));

      // --- mobile menu ---
      const menu = document.querySelector('.menu-toggle')!;
      menu.addEventListener('click', () => {
        const nav = document.querySelector('.main-nav')!;
        const open = nav.classList.toggle('nav-open');
        menu.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
