    <script is:inline define:vars={{ GA_ID, ADSENSE_ID }}>
      (function() {
        const KEY = 'koPaper_consent';
        let stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}
        function loadThirdParty() {
          const s1 = document.createElement('script');
          s1.async = true;
          s1.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s1);
          gtag('js', new Date());
          gtag('config', GA_ID);
          const s2 = document.createElement('script');
          s2.async = true;
          s2.crossOrigin = 'anonymous';
          s2.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + ADSENSE_ID;
          document.head.appendChild(s2);
          const s3 = document.createElement('script');
          s3.setAttribute('data-cfasync', 'false');
          s3.src = 'https://pl31324343.profitableratecpmnetwork.com/04bba4fddad31c9c102b34f4c1c7ad04/invoke.js';
          document.head.appendChild(s3);
        }
        function decide(v) {
          try { localStorage.setItem(KEY, v); } catch (e) {}
          if (v === 'granted') {
            gtag('consent', 'update', {
              ad_storage: 'granted', ad_user_data: 'granted',
              ad_personalization: 'granted', analytics_storage: 'granted',
            });
            loadThirdParty();
          }
          const b = document.getElementById('consentBanner');
          if (b) b.style.display = 'none';
        }
        if (stored === 'granted') {
          loadThirdParty();
        } else if (stored !== 'denied') {
          document.getElementById('consentBanner').style.display = 'block';
          document.getElementById('consentAccept').addEventListener('click', () => decide('granted'));
          document.getElementById('consentDecline').addEventListener('click', () => decide('denied'));
        }
      })();
    </script>

    <script>
      // --- prompt box ---
      const idea = document.querySelector('#idea') as HTMLTextAreaElement;
      const count = document.querySelector('#char-count')!;
      const status = document.querySelector('#generator-status')!;
      const results = document.querySelector('#results') as HTMLElement;
      const generateBtn = document.querySelector('#generate') as HTMLButtonElement;
      idea.addEventListener('input', () => count.textContent = `${idea.value.length} / 400`);

      // --- real generation via /api/generate-image ---
      const STYLE_IDS: Record<string, string> = {
        'Low Poly': 'lowpoly', 'Cute & Kawaii': 'cute', 'Blocky Voxel': 'minecraft',
        'Pixel Papercraft': 'pixel', 'Fantasy 3D': 'fantasy',
      };
      const DETAIL: Record<string, string> = {
        'Simple': 'simple clean shapes, minimal detail',
        'Balanced': '',
        'Highly Detailed': 'highly detailed, intricate paper craftsmanship',
      };

      async function generate() {
        const ideaVal = idea.value.trim();
        if (!ideaVal) {
          status.textContent = 'Add a little description first — anything you can imagine!';
          idea.focus();
          return;
        }
        const styleSel = document.querySelector('#style') as HTMLSelectElement;
        const detailSel = document.querySelector('#complexity') as HTMLSelectElement;
        const styleId = STYLE_IDS[styleSel.value] || 'cute';
        const suffix = DETAIL[detailSel.value] || '';
        const prompt = [ideaVal, suffix].filter(Boolean).join(', ');

        generateBtn.disabled = true;
        status.textContent = 'Folding your paper idea… this can take up to a minute.';
        results.classList.remove('show');
        results.innerHTML = '';
        const payload = JSON.stringify({ prompt, style: styleId });
        const headers = { 'Content-Type': 'application/json' };
        let data: any;
        try {
          const res = await fetch('/api/generate-image', { method: 'POST', headers, body: payload });
          if (!res.ok) throw new Error('route unavailable');
          data = await res.json();
        } catch (routeErr) {
          // Local preview / static host has no SSR route — fall back to the
          // production endpoint (its CORS allowlist covers localhost:4321).
          const res = await fetch('https://kopaper.com/api/generate-image', { method: 'POST', headers, body: payload });
          data = await res.json();
        }
        try {
          if (!data || !data.ok || !Array.isArray(data.images) || data.images.length === 0) throw new Error('no images');
          for (const img of data.images) {
            const src = `data:${img.mediaType || 'image/png'};base64,${img.b64}`;
            const link = document.createElement('a');
            link.href = src;
            link.download = `kopaper-${ideaVal.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40) || 'design'}.png`;
            link.title = 'Click to download this design';
            const el = document.createElement('img');
            el.src = src;
            el.alt = `AI-generated papercraft design of ${ideaVal}`;
            el.loading = 'lazy';
            link.appendChild(el);
            results.appendChild(link);
          }
          results.classList.add('show');
          status.innerHTML = 'Here it is! <b>Click an image to download it</b>, or tweak the idea and generate again.';
        } catch (e) {
          status.innerHTML = 'The generator is taking a break right now. Try again in a moment, or browse the <a href="/gallery/" style="color:var(--purple);text-decoration:underline;">gallery</a> for inspiration.';
        } finally {
          generateBtn.disabled = false;
        }
      }
      generateBtn.addEventListener('click', generate);

      // --- gallery category filter ---
      document.querySelectorAll<HTMLButtonElement>('.category-chip').forEach(button => button.addEventListener('click', () => {
        document.querySelectorAll('.category-chip').forEach(item => item.classList.remove('active'));
        button.classList.add('active');
        const category = button.dataset.category;
        document.querySelectorAll<HTMLElement>('.gallery-card').forEach(card => card.hidden = category !== 'All' && card.dataset.kind !== category);
      }));

      // --- "Try prompt" button fills the generator; card images link to the detail page ---
      document.querySelectorAll<HTMLButtonElement>('.try-prompt[data-prompt]').forEach(button => button.addEventListener('click', () => {
        idea.value = button.dataset.prompt || '';
        idea.dispatchEvent(new Event('input'));
        document.querySelector('#generator')!.scrollIntoView({ behavior: 'smooth' });
        setTimeout(() => idea.focus({ preventScroll: true }), 450);
      }));

      // --- quick prompt chips fill the generator ---
      document.querySelectorAll<HTMLButtonElement>('.quick-prompt[data-quick]').forEach(chip => chip.addEventListener('click', () => {
        idea.value = chip.dataset.quick || '';
        idea.dispatchEvent(new Event('input'));
        idea.focus();
      }));

      // --- mobile menu ---
      const menu = document.querySelector('.menu-toggle')!;
      menu.addEventListener('click', () => {
        const nav = document.querySelector('.main-nav')!;
        const open = nav.classList.toggle('nav-open');
        menu.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
