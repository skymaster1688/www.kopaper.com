---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CraftCard from '../components/CraftCard.astro';
import GalleryCard from '../components/GalleryCard.astro';
import Generator from '../components/Generator.astro';

const tutorials = (await getCollection('tutorials', ({ data }) => !data.draft && data.kind !== 'papercraft'))
  .sort((a, b) => a.data.order - b.data.order);

const featured = tutorials.filter(t => t.data.featured).slice(0, 4);
const beginners = tutorials.filter(t => t.data.difficulty === 'Easy').slice(0, 3);

const letterPapers = (await getCollection('letterPaper', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const learnArticles = (await getCollection('learn', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// Gallery: AI-generated papercraft showcase, newest first (driven by `updated`).
const galleryItems = (await getCollection('gallery', ({ data }) => !data.draft && !data.noindex))
  .sort((a, b) => (b.data.updated || '').localeCompare(a.data.updated || ''))
  .slice(0, 4);

const faqs = [
  { q: 'What is koPaper?', a: 'koPaper is an AI papercraft creator. Describe an idea and it generates papercraft designs you can print, cut, fold, and build at home.' },
  { q: 'Do I need special paper?', a: 'No. Most designs work with standard A4 or Letter size printer paper. For sturdier 3D models, cardstock (160 to 220 gsm) gives the best result.' },
  { q: 'Are these suitable for kids?', a: 'Yes. Easy tutorials are perfect for ages 6 plus with minimal adult help, and the generator needs no design skills at all.' },
  { q: 'Can I download printable templates?', a: 'Yes. Use the AI generator to create a papercraft template, then download the SVG or print it straight to PDF and assemble at home.' },
  { q: 'How do I print the letter paper designs?', a: 'Open any letter paper design page, then use your browser print function (Ctrl+P or Cmd+P). Set margins to None and choose Letter or A4 for best results.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---

<BaseLayout
  title="AI Papercraft Generator Create Custom Paper Crafts"
  description="Use the AI Papercraft Generator to create custom paper crafts from your ideas. Generate paper toys, paper art and unique designs, then print and build."
>
  <!-- 1. Hero — full width, 3D wireframe bleeds edge to edge -->
  <section class="hero-line">
    <div class="persp" aria-hidden="true">
      <svg viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice">
        <g fill="none" style="stroke: var(--text)">
          <g stroke-width="1" opacity="0.08">
            <line x1="-200" y1="520" x2="820" y2="220"/>
            <line x1="80"   y1="520" x2="820" y2="220"/>
            <line x1="360"  y1="520" x2="820" y2="220"/>
            <line x1="640"  y1="520" x2="820" y2="220"/>
            <line x1="1000" y1="520" x2="820" y2="220"/>
            <line x1="1280" y1="520" x2="820" y2="220"/>
            <line x1="0" y1="520" x2="1200" y2="520"/>
            <line x1="0" y1="460" x2="1200" y2="460"/>
            <line x1="0" y1="410" x2="1200" y2="410"/>
            <line x1="0" y1="370" x2="1200" y2="370"/>
            <line x1="0" y1="338" x2="1200" y2="338"/>
            <line x1="0" y1="312" x2="1200" y2="312"/>
            <line x1="0" y1="292" x2="1200" y2="292"/>
          </g>
          <!-- warm wireframe cube: the single warm focus in the field -->
          <g style="stroke: var(--warm)" stroke-width="1.4" opacity="0.22">
            <rect x="820" y="300" width="120" height="120"/>
            <rect x="890" y="278" width="74" height="74"/>
            <line x1="820" y1="300" x2="890" y2="278"/>
            <line x1="940" y1="300" x2="964" y2="278"/>
            <line x1="940" y1="420" x2="964" y2="352"/>
            <line x1="820" y1="420" x2="890" y2="352"/>
          </g>
          <g stroke-width="1.3" opacity="0.16">
            <polygon points="160,440 280,410 400,440 280,468"/>
            <line x1="280" y1="410" x2="280" y2="335"/>
            <line x1="280" y1="335" x2="160" y2="440"/>
            <line x1="280" y1="335" x2="400" y2="440"/>
            <line x1="280" y1="335" x2="280" y2="468"/>
          </g>
          <g stroke-width="1.3" opacity="0.22">
            <line x1="90" y1="120" x2="170" y2="120"/><polygon points="170,120 160,116 160,124" style="fill: var(--text)" stroke="none"/>
            <line x1="90" y1="120" x2="90" y2="48"/><polygon points="90,48 86,58 94,58" style="fill: var(--text)" stroke="none"/>
            <line x1="90" y1="120" x2="140" y2="160"/><polygon points="140,160 130,155 135,146" style="fill: var(--text)" stroke="none"/>
          </g>
          <g font-family="JetBrains Mono, monospace" font-size="12" style="fill: var(--text)" opacity="0.30">
            <text x="176" y="116">X</text>
            <text x="80" y="42">Y</text>
            <text x="146" y="174">Z</text>
          </g>
        </g>
      </svg>
    </div>

    <div class="wrap hero-inner">
      <div class="left">
        <p class="eyebrow"><span class="label">AI Papercraft Generator</span></p>
        <h1 class="display">Create Your Own <span class="mark">Papercraft</span> with AI</h1>
        <p class="sub">Turn your ideas into unique paper craft designs.</p>
        <p class="sub">Describe anything below &mdash; the generator runs right here on this page.</p>
      </div>

      <div class="right">
        <div class="hero-fox" aria-hidden="true">
          <svg viewBox="0 0 460 420" preserveAspectRatio="xMidYMid meet" fill="none">
            <!-- faint blueprint grid -->
            <g style="stroke: var(--text)" stroke-width="0.5" opacity="0.06">
              <line x1="0" y1="90"  x2="460" y2="90"/><line x1="0" y1="170" x2="460" y2="170"/>
              <line x1="0" y1="250" x2="460" y2="250"/><line x1="0" y1="330" x2="460" y2="330"/>
              <line x1="80"  y1="0" x2="80"  y2="420"/><line x1="200" y1="0" x2="200" y2="420"/>
              <line x1="320" y1="0" x2="320" y2="420"/><line x1="420" y1="0" x2="420" y2="420"/>
            </g>
            <!-- fox line-art (papercraft blueprint) -->
            <g style="stroke: var(--text)" stroke-width="1.4" opacity="0.38" stroke-linejoin="round" fill="none">
              <!-- tail -->
              <polygon points="30,320 55,180 150,250 120,380"/>
              <line x1="58" y1="248" x2="128" y2="372" stroke-dasharray="6 5"/>
              <!-- body -->
              <polygon points="150,250 310,235 330,400 150,400"/>
              <!-- hind + front legs -->
              <polygon points="150,400 150,322 182,322 182,400"/>
              <polygon points="288,400 288,322 320,322 320,400"/>
              <!-- head -->
              <polygon points="310,235 350,110 415,150 400,260 330,265"/>
              <!-- ears -->
              <polygon points="350,110 330,30 378,100"/>
              <polygon points="415,150 438,55 452,150"/>
              <!-- face crease -->
              <line x1="352" y1="112" x2="398" y2="262" stroke-dasharray="6 5"/>
              <!-- eye -->
              <circle cx="372" cy="186" r="7"/>
            </g>
            <!-- warm focus: ear interiors + nose -->
            <g style="stroke: var(--warm)" stroke-width="1.6" stroke-linejoin="round" fill="none">
              <polygon points="350,110 338,56 370,102"/>
              <polygon points="415,150 433,76 449,148"/>
              <polygon points="388,248 408,248 398,266"/>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Generator />
  </div>

  <div class="wrap">
    <div class="stats">
      <div class="stat"><div class="n">01</div><div class="l">design / prompt</div></div>
      <div class="stat"><div class="n">04</div><div class="l">art styles</div></div>
      <div class="stat"><div class="n">100%</div><div class="l">free &middot; no sign-up</div></div>
      <div class="stat"><div class="n">&infin;</div><div class="l">ideas</div></div>
    </div>
  </div>

  <!-- 2b. AI Papercraft Generator focus (SEO) -->
  <div class="wrap">
    <section class="sec">
      <div class="sec-head">
        <span class="label">The generator</span>
        <h2 class="display">Meet the AI Papercraft Generator</h2>
        <p>The AI Papercraft Generator turns a short sentence into original papercraft designs you can print and build at home.</p>
      </div>
      <div class="gen-grid">
        <aside class="gen-visual" aria-label="A folded paper fox you can build from a net">
          <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Origami paper fox">
            <!-- warm accents: ear inner + snout -->
            <g style="stroke: var(--warm)" stroke-width="1.8" stroke-linejoin="round" fill="none">
              <polygon points="120,140 95,60 175,135"/>
              <polygon points="200,286 186,262 214,262"/>
            </g>
            <!-- main outline (solid) -->
            <g style="stroke: var(--text)" stroke-width="1.8" stroke-linejoin="round" fill="#fff">
              <polygon points="120,140 95,60 175,135"/>
              <polygon points="280,140 305,60 225,135"/>
              <polygon points="120,140 280,140 200,300"/>
            </g>
            <!-- fold creases (dashed) -->
            <g style="stroke: var(--text)" stroke-width="1" stroke-dasharray="6 5" opacity="0.5">
              <line x1="200" y1="140" x2="200" y2="300"/>
              <line x1="175" y1="135" x2="200" y2="205"/>
              <line x1="225" y1="135" x2="200" y2="205"/>
              <line x1="120" y1="140" x2="200" y2="205"/>
              <line x1="280" y1="140" x2="200" y2="205"/>
            </g>
            <!-- eyes (solid) -->
            <polygon points="158,198 182,208 160,214" style="fill: var(--text)" stroke="none"/>
            <polygon points="242,198 218,208 240,214" style="fill: var(--text)" stroke="none"/>
          </svg>
        </aside>
        <div class="gen-copy">
          <p>Type an idea like <em>a cute dragon</em> or <em>a low poly castle</em>, and the AI Papercraft Generator returns a custom papercraft design in your chosen style. Each one is drawn as clean line art you can print, cut, fold, and glue into a real paper model. No templates to hunt and no folding diagrams to decode.</p>
          <p>Want paper toys, paper art, or a one of a kind gift? The papercraft generator helps you create papercraft that matches your own idea instead of copying someone else's. Pick Cute, Low Poly, Pixel, or Fantasy, then generate, refine, and download your favorite as an SVG or PDF.</p>
          <h3>Why use an AI papercraft generator?</h3>
          <p>A papercraft generator is fastest when you already know what you want but cannot draw it. Describe the subject, set the style, and let the tool handle the artwork. You stay in control of the idea; the generator handles the rendering, so you can move from thought to paper in minutes.</p>
          <p class="gen-cta"><a class="btn btn-primary" href="/tools/">Browse style generators &rarr;</a></p>
        </div>
      </div>
    </section>
  </div>

  <!-- 2. How it works -->
  <div class="wrap">
    <section class="sec">
      <div class="sec-head">
        <span class="label">How it works</span>
        <h2 class="display">From idea to paper in three steps</h2>
        <p>No templates to hunt, no folding diagrams to decode. Just describe and build.</p>
      </div>
      <div class="steps">
        <div class="step"><div class="idx">01 &mdash; INPUT</div><h3>Describe</h3><p>Type what you imagine &mdash; a fox, a castle, a gift box. Pick a style if you like.</p></div>
        <div class="step"><div class="idx">02 &mdash; RENDER</div><h3>Generate</h3><p>koPaper draws an original papercraft design you can preview instantly.</p></div>
        <div class="step"><div class="idx">03 &mdash; BUILD</div><h3>Assemble</h3><p>Print, cut along the lines, fold, and glue. Your idea is now a real paper model.</p></div>
      </div>
    </section>

    <!-- 2c. Gallery: real AI-generated designs -->
    {galleryItems.length > 0 && (
      <section class="sec">
        <div class="sec-head">
          <span class="label">Gallery</span>
          <h2 class="display">Fresh from the generator</h2>
          <p>Papercraft designs created with the AI generator, ready to print and build.</p>
        </div>
        <div class="grid-4">
          {galleryItems.map(g => (
            <GalleryCard
              href={`/gallery/${g.slug}/`}
              title={g.data.title}
              description={g.data.description}
              body={g.body}
              emoji={g.data.emoji}
            />
          ))}
        </div>
        <div class="reveal" style="text-align:center; margin-top:28px">
          <a href="/gallery/" class="btn btn-outline">View all designs</a>
        </div>
      </section>
    )}

    <!-- 3. Explore pillars -->
    <section class="sec">
      <div class="sec-head">
        <span class="label">Explore</span>
        <h2 class="display">Start from a crafted starting point</h2>
        <p>Prefer a manual project? Browse our guided tutorials and printable templates.</p>
      </div>
      <div class="explore">
        <a href="/origami/" class="ecard">
          <div class="top"><span class="fig">FIG. A</span><span class="fig">MAKE</span></div>
          <div class="body"><h3>Tutorials</h3><p>Step-by-step origami and paper crafts for all ages.</p><span class="go">Browse <span class="ar"></span></span></div>
        </a>
        <a href="/templates/" class="ecard">
          <div class="top"><span class="fig">FIG. B</span><span class="fig">PRINT</span></div>
          <div class="body"><h3>Templates</h3><p>Printable 3D paper model templates, ready to cut.</p><span class="go">Browse <span class="ar"></span></span></div>
        </a>
        <a href="/letter-paper/" class="ecard">
          <div class="top"><span class="fig">FIG. C</span><span class="fig">WRITE</span></div>
          <div class="body"><h3>Letter Paper</h3><p>Free printable letter paper designs for notes.</p><span class="go">Browse <span class="ar"></span></span></div>
        </a>
        <a href="/learn/" class="ecard">
          <div class="top"><span class="fig">FIG. D</span><span class="fig">LEARN</span></div>
          <div class="body"><h3>Learn</h3><p>Paper basics &amp; guides — choose the right sheet for every fold and cut.</p><span class="go">Browse <span class="ar"></span></span></div>
        </a>
      </div>
    </section>

    <!-- 4. Beginner tutorials (SEO entry) -->
    {beginners.length > 0 && (
      <section class="sec">
        <div class="sec-head">
          <span class="label">Getting started</span>
          <h2 class="display">Start with a tutorial</h2>
          <p>Easy paper crafts for your very first project.</p>
        </div>
        <div class="grid-3">
          {beginners.map(t => (
            <CraftCard
              href={`/origami/${t.slug}/`}
              emoji={t.data.emoji}
              title={t.data.title}
              description={t.data.description}
              difficulty={t.data.difficulty}
              time={t.data.time}
            />
          ))}
        </div>
      </section>
    )}

    <!-- 5. Popular crafts (SEO entry) -->
    {featured.length > 0 && (
      <section class="sec">
        <div class="sec-head">
          <span class="label">Most loved</span>
          <h2 class="display">Popular paper crafts</h2>
          <p>Most-loved tutorials from Easy to Hard.</p>
        </div>
        <div class="grid-4">
          {featured.map(t => (
            <CraftCard
              href={`/origami/${t.slug}/`}
              emoji={t.data.emoji}
              title={t.data.title}
              description={t.data.description}
              difficulty={t.data.difficulty}
              time={t.data.time}
            />
          ))}
        </div>
        <div class="reveal" style="text-align:center; margin-top:28px">
          <a href="/origami/" class="btn btn-outline">View all crafts</a>
        </div>
      </section>
    )}

    <!-- 6. Letter paper gallery (SEO entry) -->
    {letterPapers.length > 0 && (
      <section class="sec">
        <div class="sec-head">
          <span class="label">Stationery</span>
          <h2 class="display">Beautiful Letter Paper Designs</h2>
          <p>Free printable letter paper for every occasion.</p>
        </div>
        <div class="grid-4">
          {letterPapers.map(p => (
            <a href={`/letter-paper/${p.slug}/`} class="craft-card card reveal">
              <div class="card-emoji">{p.data.emoji}</div>
              <div class="card-body">
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 6b. Learn guides (SEO entry) -->
    {learnArticles.length > 0 && (
      <section class="sec">
        <div class="sec-head">
          <span class="label">Learn</span>
          <h2 class="display">Paper guides &amp; basics</h2>
          <p>The paper behind every craft — what to use, why it matters, and how to choose right.</p>
        </div>
        <div class="grid-4">
          {learnArticles.slice(0, 4).map(g => (
            <CraftCard
              href={`/learn/${g.slug}/`}
              emoji={g.data.emoji}
              title={g.data.title}
              description={g.data.description}
            />
          ))}
        </div>
        <div class="reveal" style="text-align:center; margin-top:28px">
          <a href="/learn/" class="btn btn-outline">View all guides</a>
        </div>
      </section>
    )}

    <!-- 7. FAQ -->
    <section class="sec">
      <div class="sec-head">
        <span class="label">FAQ</span>
        <h2 class="display">Frequently Asked Questions</h2>
        <p>Everything you need to know to get started.</p>
      </div>
      <div class="reveal">
        {faqs.map(f => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- 8. CTA -->
    <section class="cta">
      <div>
        <h2 class="display">What will you create?</h2>
        <p>Open the studio and turn your first idea into papercraft.</p>
      </div>
      <a href="/tools/" class="btn btn-onwarm">Browse style generators &rarr;</a>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

</BaseLayout>
