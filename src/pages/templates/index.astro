---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CraftCard from '../../components/CraftCard.astro';

const templates = (await getCollection('tutorials', ({ data }) => !data.draft && data.kind === 'papercraft'))
  .sort((a, b) => a.data.order - b.data.order);

const learnGuides = (await getCollection('learn', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order).slice(0, 4);

---

<BaseLayout
  title="Free 3D Paper Craft Templates to Print"
  description="Browse free papercraft templates and origami-style designs. Explore AI-generated papercraft designs, origami tutorials, and printable crafts."
>
  <section class="hero container" style="padding-bottom:20px">
    <h1 class="reveal">Free 3D Paper Craft Templates</h1>
    <p class="reveal">Download, print, and assemble 3D paper models at home. Perfect for craft enthusiasts and kids.</p>
  </section>

  <section class="section container" style="padding-top:20px">
    {templates.length > 0 ? (
      <div class="grid-3">
        {templates.map(t => (
          <CraftCard
            href={`/templates/${t.slug}/`}
            emoji={t.data.emoji}
            title={t.data.title}
            description={t.data.description}
            difficulty={t.data.difficulty}
            time={t.data.time}
          />
        ))}
      </div>
    ) : (
      <p style="color:var(--text-muted); text-align:center; padding:40px 0">Templates coming soon. Check back shortly!</p>
    )}
  </section>

  {learnGuides.length > 0 && (
    <section class="section container" style="padding-top:20px">
      <h2 class="section-title reveal">Paper Guides &amp; Basics</h2>
      <div class="grid-4" style="margin-top:20px">
        {learnGuides.map(g => (
          <CraftCard
            href={`/learn/${g.slug}/`}
            emoji={g.data.emoji}
            title={g.data.title}
            description={g.data.description}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
