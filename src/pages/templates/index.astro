---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CraftCard from '../../components/CraftCard.astro';

const templates = (await getCollection('tutorials', ({ data }) => !data.draft && data.category === 'models'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Printable Paper Craft Templates | koPaper"
  description="Download free printable templates for 3D paper models. Dragons, houses, robots, and more — print, cut, fold, and assemble at home."
>
  <section class="hero container" style="padding-bottom:20px">
    <h1 class="reveal">Printable Templates</h1>
    <p class="reveal">Download, print, and assemble 3D paper models at home. Perfect for craft enthusiasts and kids.</p>
  </section>

  <section class="section container" style="padding-top:20px">
    {templates.length > 0 ? (
      <div class="grid-3">
        {templates.map(t => (
          <CraftCard
            href={`/origami/${t.slug}/`}
            emoji={t.data.emoji}
            title={t.data.title}
            description={t.data.description}
            difficulty={t.data.difficulty}
            time={t.data.time}
          />
        ))}
      </div>
    ) : (
      <p style="color:var(--text-muted); text-align:center; padding:40px 0">Templates coming soon. Check back shortly!</p>
    )}
  </section>
</BaseLayout>
