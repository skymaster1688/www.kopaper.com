---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubjectGallery from '../../components/SubjectGallery.astro';

const title = 'Animal Papercraft Designs: Fox, Cat & Panda Ideas';
const description = 'Free AI papercraft designs of animals — fox, cat, panda, hedgehog, iguana and more. Open a design, copy its prompt, and generate your own version.';

const siblings = [
  { href: '/gallery/animal/', label: 'Animals' },
  { href: '/gallery/dragon/', label: 'Dragons' },
  { href: '/gallery/vehicle/', label: 'Vehicles' },
  { href: '/gallery/building/', label: 'Buildings' },
];
---
<BaseLayout title={title} description={description} ogType="website">
  <section class="hero container" style="padding-bottom:10px">
    <nav class="breadcrumb" style="margin-bottom:16px">
      <a href="/">Home</a><span>/</span><a href="/gallery/">Gallery</a><span>/</span><span>Animals</span>
    </nav>
    <h1 class="reveal">Animal Papercraft Designs</h1>
    <p class="reveal" style="max-width:720px">
      Animals are the most forgiving subject in papercraft. A fox, a panda or a hedgehog reads instantly from
      its silhouette, so even a simple faceted model looks finished on a shelf. They are also the easiest
      designs to scale up: the same prompt that gives you a palm-sized cat will give you a display-piece
      elephant if you describe it that way.
    </p>
    <p class="reveal" style="max-width:720px">
      Every design below was generated from one written prompt. Open any of them to see the full prompt and
      the style it used, then edit the words — change the animal, the pose, or the material — and generate
      your own version in the <a href="/">papercraft generator</a>. Low poly suits animals best because
      flat facets read as muscle and fur without needing any texture.
    </p>
  </section>

  <SubjectGallery subject="animal" heading="Animal papercraft designs" intro="" siblings={siblings} />
</BaseLayout>
