---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryCard from '../../components/GalleryCard.astro';

const items = (await getCollection('gallery', ({ data }) => !data.draft && !data.noindex))
  .sort((a, b) => (b.data.updated || `0-${b.slug}`).localeCompare(a.data.updated || `0-${a.slug}`));
---
<BaseLayout
  title="AI Papercraft Gallery | koPaper"
  description="A growing showcase of papercraft designs made with koPaper's AI papercraft generator. Browse cute, low poly, pixel, and fantasy paper art you can print and build."
>
  <section class="hero container" style="padding-bottom:20px">
    <h1 class="reveal">Gallery</h1>
    <p class="reveal">Papercraft designs created with the koPaper AI generator — described from a sentence, styled, and ready to inspire your next papercraft project.</p>
  </section>

  <section class="section container" style="padding-top:20px">
    {items.length === 0 ? (
      <p style="color:var(--text-muted)">No designs published yet. Open the <a href="/">generator</a> and hit <strong>Publish</strong> on your first creation.</p>
    ) : (
      <div class="grid-4" style="margin-top:20px">
        {items.map(g => (
          <GalleryCard
            href={`/gallery/${g.slug}/`}
            title={g.data.title}
            description={g.data.description}
            body={g.body}
            emoji={g.data.emoji}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
