---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryCard from '../../components/GalleryCard.astro';
import { detectSubject } from '../../lib/gallery';

export async function getStaticPaths() {
  const items = await getCollection('gallery', ({ data }) => !data.draft && !data.noindex);
  return items.map(g => ({
    params: { slug: g.slug },
    props: { item: g },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site.href },
    { '@type': 'ListItem', position: 2, name: 'Gallery', item: new URL('/gallery/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: item.data.title },
  ],
};

const all = await getCollection('gallery', ({ data }) => !data.draft && !data.noindex);
// Extract prompt from description (quoted string) or fall back to title
function promptOf(d: any): string {
  const m = (d.description || '').match(/"([^"]+)"/);
  return m ? m[1] : (d.title || '');
}
const currentCat = detectSubject(promptOf(item.data)).category;
const byDate = (a: any, b: any) => (b.data.updated || `0-${b.slug}`).localeCompare(a.data.updated || `0-${a.slug}`);
const sameCat = all.filter(g => g.slug !== item.slug && detectSubject(promptOf(g.data)).category === currentCat).sort(byDate);
const otherCat = all.filter(g => g.slug !== item.slug && detectSubject(promptOf(g.data)).category !== currentCat).sort(byDate);
const related = [...sameCat, ...otherCat].slice(0, 3);

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.data.title,
  description: item.data.description,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@type': 'Organization', name: 'koPaper', url: Astro.site.href },
  publisher: { '@type': 'Organization', name: 'koPaper', url: Astro.site.href },
};
if (item.data.updated) {
  articleSchema.datePublished = item.data.updated;
  articleSchema.dateModified = item.data.updated;
}
const imgMatch = item.body.match(/!\[[^\]]*\]\((\/[^)\s]+)\)/);
if (imgMatch) articleSchema.image = new URL(imgMatch[1], Astro.site).href;
---
<BaseLayout
  title={item.data.title}
  description={item.data.description}
  ogType="article"
  noindex={item.data.noindex}
>
  <article class="container" style="max-width:820px; padding-top:40px">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/gallery/">Gallery</a>
      <span>/</span>
      <span>{item.data.title}</span>
    </nav>

    <h1 style="margin-bottom:12px">{item.data.emoji} {item.data.title}</h1>
    <p style="font-size:1.15rem; color:var(--text-muted); margin-bottom:24px">{item.data.description}</p>
    <div style="display:flex; align-items:center; gap:12px; font-size:0.88rem; color:var(--text-muted); margin-bottom:28px; flex-wrap:wrap">
      <span style="display:flex; align-items:center; gap:7px">
        <span style="width:26px; height:26px; border-radius:50%; background:var(--warm); color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:0.68rem; font-weight:700">kP</span>
        <a href="/about/" style="color:var(--text); font-weight:600; text-decoration:none">koPaper Team</a>
      </span>
      {item.data.updated && <><span style="color:var(--border)">•</span><span>Published {item.data.updated}</span></>}
      <span style="color:var(--border)">•</span>
      <span>3 min read</span>
    </div>

    <div class="gallery-content">
      <Content />
    </div>

    <section style="margin-top:44px; padding:20px 22px; border:1px solid var(--border); border-radius:var(--radius); background:var(--surface); display:flex; gap:16px; align-items:flex-start">
      <div style="width:46px; height:46px; border-radius:50%; background:var(--warm); color:#fff; display:flex; align-items:center; justify-content:center; font-size:0.95rem; font-weight:700; flex-shrink:0">kP</div>
      <div>
        <div style="font-weight:700; margin-bottom:5px; font-size:0.98rem"><a href="/about/" style="color:var(--text); text-decoration:none">koPaper Team</a></div>
        <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.65; margin:0">
          Papercraft enthusiasts and AI engineers building beautiful papercraft designs. Every design is AI-generated and human-reviewed before publication. <a href="/about/" style="color:var(--warm); text-decoration:underline">Learn more →</a>
        </p>
      </div>
    </section>

    <section class="learn-links" style="margin-top:40px; padding:20px 22px; border:1px solid var(--border); border-radius:var(--radius); background:var(--surface)">
      <h2 style="font-size:1.1rem; margin-bottom:10px">Make your own</h2>
      <ul style="margin:0; padding-left:18px; color:var(--text-muted)">
        <li><a href="/">AI papercraft generator</a> — turn any idea into a printable craft, then publish it here.</li>
        <li><a href="/origami/">Step-by-step origami tutorials</a> — fold animals, flowers, and geometric designs.</li>
        <li><a href="/printables/">Free printable crafts</a> — cards, gift tags, and paper craft sheets.</li>
      </ul>
    </section>

    {related.length > 0 && (
      <section style="margin-top:50px; padding-top:36px; border-top:1px solid var(--border)">
        <h2 style="font-size:1.3rem; margin-bottom:20px">More from the Gallery</h2>
        <div class="grid-3">
          {related.map(g => (
            <GalleryCard
              href={`/gallery/${g.slug}/`}
              title={g.data.title}
              description={g.data.description}
              body={g.body}
              emoji={g.data.emoji}
            />
          ))}
        </div>
      </section>
    )}
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <style is:global>
    .gallery-content { margin-top: 28px; }
    .gallery-content p { color: var(--text-muted); margin-bottom: 16px; line-height: 1.7; }
    .gallery-content img {
      display: block; max-width: 100%; height: auto; margin: 22px auto;
      border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
    }
    .gallery-content em { display: block; text-align: center; color: var(--text-muted); font-size: 0.92rem; margin: -10px 0 22px; }
    .gallery-content a { color: var(--warm); text-decoration: underline; }
  </style>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
