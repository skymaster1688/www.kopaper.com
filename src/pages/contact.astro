---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact koPaper — Questions, Feedback &amp; Support"
  description="Contact the koPaper team: support, feedback, content requests, and privacy questions. We read every message."
  canonical="/contact/"
>

  <div class="wrap">
    <article class="policy">
      <span class="eyebrow">Contact</span>
      <h1>Contact us</h1>
      <p class="updated">We reply to most messages within 2 business days.</p>

      <section>
        <h2>Email</h2>
        <p>General questions, feedback, and collaboration ideas: <a href="mailto:hello@kopaper.com">hello@kopaper.com</a></p>
        <p>Privacy and data requests (including removal from our public gallery): <a href="mailto:privacy@kopaper.com">privacy@kopaper.com</a></p>
        <p>Technical issues with the generator: <a href="mailto:support@kopaper.com">support@kopaper.com</a></p>
      </section>

      <section>
        <h2>What to include</h2>
        <p>To help us answer faster, please include the page URL you're writing about and a short description of the issue or idea. If you're requesting removal of a design from our gallery, include the exact gallery page link.</p>
      </section>

      <section>
        <h2>Business inquiries</h2>
        <p>For advertising, partnerships, and content licensing, please email <a href="mailto:hello@kopaper.com">hello@kopaper.com</a> with "Business" in the subject line.</p>
      </section>
    </article>
  </div>

</BaseLayout>
