---
interface Props {
  defaultStyle?: 'cute' | 'lowpoly' | 'pixel' | 'fantasy';
  defaultPrompt?: string;
}
const { defaultStyle = 'cute', defaultPrompt = '' } = Astro.props;

const STYLES = [
  { id: 'cute', label: 'Cute', hint: 'round kawaii forms' },
  { id: 'lowpoly', label: 'Low Poly', hint: 'geometric facets' },
  { id: 'pixel', label: 'Pixel', hint: '8-bit sprite' },
  { id: 'fantasy', label: 'Fantasy', hint: 'magical glow' },
];
---

<!-- Generator app — reusable on the homepage and on /tools/<style>/ pages. -->
<section class="gen-app reveal" aria-label="Papercraft generator" data-default-style={defaultStyle}>
  <aside class="gen-side">
    <div class="field">
      <label for="prompt">Describe your idea</label>
      <div class="prompt-row">
        <input type="text" id="prompt" placeholder="a cute panda, a fantasy castle, a robot toy" autocomplete="off" />
        <button class="btn btn-ghost btn-sm" id="polishBtn" type="button" title="Expand and clean up your idea">AI polish</button>
      </div>
      <p class="prompt-preview" id="promptPreview" aria-live="polite"></p>
    </div>
    <div class="field">
      <label>Style <span class="field-hint">adds a papercraft look</span></label>
      <div class="style-chips" id="styleChips" role="group" aria-label="Style">
        {STYLES.map((s) => (
          <button type="button" class="style-chip" data-style={s.id} aria-pressed={s.id === defaultStyle}>
            {s.label}<span>{s.hint}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="field">
      <label>Reference image (planned)</label>
      <label class="upload-btn" for="upload">Upload image</label>
      <input type="file" id="upload" accept="image/*" hidden />
    </div>
    <div class="gen-actions">
      <button class="btn btn-ghost" id="surprise" type="button">Surprise me</button>
      <button class="btn btn-primary btn-large" id="generateBtn" type="button">Generate Design</button>
    </div>
  </aside>

  <div class="gen-stage">
    <div class="stage-frame">
      <div class="result-grid" id="resultGrid">
        <div class="result-card" data-i="0">
          <div class="thumb"></div>
          <div class="meta"><span class="title">Your design</span><span class="dir-tag"></span></div>
        </div>
      </div>
    </div>
    <div class="gen-loading" id="genLoading" hidden>
      <div class="spinner" aria-hidden="true"></div>
      <p id="genStatus">Planning content elements…</p>
    </div>
  </div>
</section>

<style>
  /* Generator input: prompt row, live preview, style chips */
  .prompt-row { display: flex; gap: 8px; align-items: stretch; }
  .prompt-row input { flex: 1; min-width: 0; }
  .btn-sm { padding: 0 14px; font-size: .9rem; white-space: nowrap; }
  .prompt-preview { margin: 8px 0 0; font-size: .8rem; line-height: 1.5; color: var(--text-muted); font-family: var(--font-mono); background: var(--warm-soft); border: 1px solid var(--warm); border-radius: var(--radius-sm); padding: 8px 10px; word-break: break-word; }
  .field-hint { font-weight: 400; color: var(--text-muted); font-size: .78rem; margin-left: 4px; }
  .style-chips { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .style-chip { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 9px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text); font: inherit; font-size: .92rem; cursor: pointer; text-align: left; transition: border-color .15s, background .15s; }
  .style-chip span { font-size: .72rem; color: var(--text-muted); }
  .style-chip[aria-pressed="true"] { border-color: var(--warm); background: var(--warm-soft); }

  .gen-stage { position: relative; }
  .gen-loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; color: var(--text-muted); background: var(--surface); }
  .gen-loading[hidden] { display: none; }
  .gen-loading p { font-size: 1.08rem; letter-spacing: .02em; }
  .gen-loading .spinner { width: 36px; height: 36px; border: 3px solid var(--border); border-top-color: var(--warm); border-radius: 50%; animation: kp-spin 0.9s linear infinite; }
  @keyframes kp-spin { to { transform: rotate(360deg); } }
  .design-note { margin: 8px 0 0; font-size: .75rem; color: var(--text-muted); text-align: center; font-style: italic; }
</style>

<script define:vars={{ defaultStyle, defaultPrompt }}>
  import { pickDirections } from '../../lib/directions';
  // Monochrome line-art output: white paper, ink lines (printable + on-brand).
  const STYLE_PALETTES = {
    cute:    ['#FFFFFF', '#0A0A0B'],
    lowpoly: ['#FFFFFF', '#0A0A0B'],
    pixel:   ['#FFFFFF', '#0A0A0B'],
    fantasy: ['#FFFFFF', '#0A0A0B'],
  };
  // Style phrases injected into the prompt so "style" is a real hint, not just a label.
  const STYLE_PHRASES = {
    cute: 'cute kawaii',
    lowpoly: 'low poly geometric',
    pixel: 'pixel art',
    fantasy: 'fantasy magical',
  };
  // Fixed papercraft anchor — kept in sync with the server-side buildPrompt so the
  // preview mirrors what the model actually receives.
  const PROMPT_TAIL = 'paper art sculpture, papercraft design, clean light background, high detail';

  const $ = (id) => document.getElementById(id);
  const promptEl = $('prompt');
  const styleChips = $('styleChips');
  const polishBtn = $('polishBtn');
  const promptPreview = $('promptPreview');

  function getStyle() {
    const sel = styleChips && styleChips.querySelector('.style-chip[aria-pressed="true"]');
    return sel ? sel.dataset.style : (defaultStyle || 'cute');
  }
  function setStyle(style) {
    if (!styleChips) return;
    styleChips.querySelectorAll('.style-chip').forEach(c => {
      c.setAttribute('aria-pressed', String(c.dataset.style === style));
    });
    updatePreview();
  }
  // Live preview of the exact prompt the model will receive: fixed base + user input + style phrase.
  function updatePreview() {
    if (!promptPreview) return;
    const idea = promptEl.value.trim();
    const phrase = STYLE_PHRASES[getStyle()] || STYLE_PHRASES.cute;
    const shown = idea || 'your idea';
    promptPreview.textContent = `${phrase} papercraft of ${shown}, ${PROMPT_TAIL}`;
  }
  // Heuristic, free "AI polish": trims filler, drops leading articles/commands,
  // capitalizes, and de-duplicates words so a rough idea reads like a clean prompt.
  function polishPrompt(text) {
    let t = text.trim().replace(/\s+/g, ' ');
    t = t.replace(/^(please\s+)?(make|create|generate|give me|i want|i need|a|an|the|some)\s+/i, '');
    if (t) t = t.charAt(0).toUpperCase() + t.slice(1);
    const seen = new Set();
    const uniq = t.split(' ').filter(Boolean).filter(w => {
      const k = w.toLowerCase();
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    });
    return uniq.join(' ');
  }

  function pickFromPrompt(text) {
    const q = text.toLowerCase();
    if (/(person|man|woman|boy|girl|child|kid|people|teacher|doctor|astronaut|soldier|player|character|human|face|head)/.test(q)) return 'person';
    if (/(animal|fox|cat|dog|bear|panda|rabbit|lion|tiger|elephant|bird|fish|owl|deer|wolf|monkey|frog|turtle|butterfly|dragon|unicorn)/.test(q)) return 'animal';
    if (/(castle|spaceship|spacecraft|rocket|ship|boat|airplane|plane|ufo|alien|monster|fairy|wizard|magic|fantasy|dream|future|sci-fi|scifi|mecha|giant)/.test(q)) return 'fantasy';
    if (/(pen|pencil|book|desk|eraser|ruler|notebook|paper|stationery|school|ball|bat|racket|helmet|whistle|basketball|football|soccer|tennis|baseball|sport|cup|bottle|clock|phone|camera|lamp|chair|table|guitar|piano|umbrella|hat|shoe|bag|gift|box|toy|car|truck|bike|bicycle|train|bus)/.test(q)) return 'object';
    return null;
  }

  let currentSVGs = [];
  let currentImages = [];
  let currentDirs = [];

  const GEN_STATUS = [
    'Planning content elements…',
    'Generating style…',
    'Refining image details…',
    'Rendering final look…',
    'Finalizing details…',
    'Finalizing style…',
  ];
  let statusTimer = null;
  let statusIdx = 0;
  function startStatus() {
    const el = $('genStatus');
    if (!el) return;
    statusIdx = 0;
    el.textContent = GEN_STATUS[0];
    if (statusTimer) clearInterval(statusTimer);
    statusTimer = setInterval(() => {
      statusIdx = Math.min(statusIdx + 1, GEN_STATUS.length - 1);
      el.textContent = GEN_STATUS[statusIdx];
    }, 2500);
  }
  function stopStatus() {
    if (statusTimer) { clearInterval(statusTimer); statusTimer = null; }
  }

  function setLoading(on) {
    const btn = $('generateBtn');
    if (btn) { btn.disabled = on; btn.textContent = on ? 'Generating…' : 'Generate Design'; }
    const grid = $('resultGrid');
    if (grid) grid.classList.toggle('loading', on);
    const loading = $('genLoading');
    if (loading) loading.hidden = !on;
    if (on) startStatus(); else stopStatus();
  }

  // Render the grid: one main card with the generated image, plus a directions
  // panel with 3-5 text suggestions. No templated filler text.
  function renderResult(img, dirs) {
    const grid = $('resultGrid');
    if (!grid) return;
    grid.innerHTML = '';
    const main = document.createElement('div');
    main.className = 'result-card';
    main.innerHTML =
      '<div class="thumb">' +
        (img && img.b64
          ? '<img class="gen-img" alt="Your papercraft design" src="data:' + img.mediaType + ';base64,' + img.b64 + '" loading="lazy" decoding="async">'
          : '<img class="gen-img" alt="Your papercraft design" src="' + img.src + '" width="400" height="400" loading="lazy" decoding="async">') +
      '</div>' +
      '<div class="meta"><span class="title">Your design</span>' +
      '<span class="actions"><button type="button" class="mini" data-i="0">Download</button></span></div>';
    grid.appendChild(main);
    main.querySelector('.mini').addEventListener('click', () => downloadAsset(0));
    const panel = document.createElement('div');
    panel.className = 'dir-panel';
    panel.innerHTML =
      '<h3 class="dir-heading">Ways to take it further</h3>' +
      '<ul class="dir-list">' +
      dirs.map((d) => '<li class="dir-item"><span class="dir-tag">' + d.title + '</span><p>' + (d.prompt || d.hint) + '</p></li>').join('') +
      '</ul>';
    grid.appendChild(panel);
  }

  // Real AI generation: keep the user's own prompt for the image, then show it
  // alongside 3-5 direction suggestions as content.
  async function generate() {
    const q = promptEl.value.trim() || 'a papercraft';
    const style = getStyle();
    const start = Date.now();
    setLoading(true);
    const dirs = pickDirections(q);
    let ok = false;
    try {
      const res = await fetch('/api/generate-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt: q, style, n: 1 }),
      });
      if (res.ok) {
        const data = await res.json();
        if (data && data.ok && data.images && data.images.length) {
          const aiDirs = (data.directions && data.directions.length) ? data.directions : dirs;
          currentImages = data.images;
          currentSVGs = [];
          currentDirs = aiDirs.map((d) => d.title);
          renderResult(data.images[0], aiDirs);
          ok = true;
        }
      }
    } catch (_) { /* fall through to fallback image */ }
    if (!ok) generateFallback(dirs);
    await minDelay(start);
    setLoading(false);
    if (ok) autoPublish();
  }

  // Fallback when the API is unavailable: reuse the pre-generated AI category
  // image for the main card, still with the direction suggestions as content.
  function generateFallback(dirs) {
    const q = promptEl.value.trim();
    const matched = pickFromPrompt(q);
    const base = matched || 'object';
    const imgMap = {
      object: '/assets/ai/cat-object.jpg',
      person: '/assets/ai/cat-person.jpg',
      animal: '/assets/ai/cat-animal.jpg',
      fantasy: '/assets/ai/cat-fantasy.jpg',
    };
    const list = (dirs && dirs.length ? dirs : pickDirections(q || 'a papercraft'));
    currentSVGs = [];
    currentImages = [];
    renderResult({ src: imgMap[base] }, list);
  }

  function surprise() {
    const styles = Object.keys(STYLE_PALETTES);
    setStyle(styles[Math.floor(Math.random() * styles.length)]);
    const ideas = ['a cute panda', 'a fantasy castle', 'a robot toy', 'a gift box', 'a paper fortune teller', 'a low poly pyramid'];
    promptEl.value = ideas[Math.floor(Math.random() * ideas.length)];
    updatePreview();
    generate();
  }

  function downloadAsset(i) {
    const img = currentImages[i];
    if (img && img.b64) {
      const a = document.createElement('a');
      a.href = `data:${img.mediaType};base64,${img.b64}`;
      a.download = `kopaper-design-${i + 1}.png`;
      a.click();
      return;
    }
    const data = currentSVGs[i];
    if (!data) return;
    const blob = new Blob(['<?xml version="1.0" encoding="UTF-8"?>\n' + data], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `kopaper-design-${i + 1}.svg`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // Stage the current design into the daily Gallery queue (KV) in the background.
  // Best-effort: failures are silent so they never interrupt the user. The queue
  // is flushed to the live site once per day via /api/publish-flush (one deploy).
  async function autoPublish() {
    // Only queue designs with a real idea — skip placeholder/empty prompts so
    // exploratory generates don't flood the daily Gallery queue.
    const raw = promptEl.value.trim();
    if (!raw || raw.toLowerCase() === 'a papercraft') return;
    const style = getStyle();
    const img = currentImages[0];
    const svg = currentSVGs[0];
    // The AI image is generated from the FULL prompt, but the Gallery title/meta
    // should be a short, clean subject (first clause). This keeps long cinematic
    // prompts from overflowing the queue char limit or producing garbled titles.
    const subject = raw.split(/[,.]/)[0].trim() || raw;
    const payload = { prompt: subject, style };
    if (img && img.b64) {
      Object.assign(payload, { kind: 'raster', b64: img.b64, mediaType: img.mediaType });
    } else if (svg) {
      Object.assign(payload, { kind: 'svg', svg });
    } else {
      return;
    }
    try {
      const r = await fetch('/api/publish-queue', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!r.ok) {
        let msg = '';
        try { msg = (await r.json()).error || ''; } catch (_) { /* ignore */ }
        console.warn('[koPaper] gallery queue rejected:', r.status, msg);
      }
    } catch (_) { /* queue is best-effort; network errors are non-fatal */ }
  }

  // Wire events
  $('generateBtn').addEventListener('click', generate);
  $('surprise').addEventListener('click', surprise);
  // Style chips select a look (updates the preview) but do NOT auto-generate.
  if (styleChips) styleChips.addEventListener('click', (e) => {
    const btn = e.target.closest('.style-chip');
    if (!btn) return;
    setStyle(btn.dataset.style);
  });
  // AI polish: expand/clean the idea in place, then refresh the preview (no generate).
  if (polishBtn) polishBtn.addEventListener('click', () => {
    const p = polishPrompt(promptEl.value);
    if (p) promptEl.value = p;
    updatePreview();
  });
  promptEl.addEventListener('input', updatePreview);
  promptEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') generate(); });
  const upload = $('upload');
  if (upload) upload.addEventListener('change', () => { alert('Image to papercraft is planned. For now, describe your idea in the text box and generate.'); upload.value = ''; });

  // Prefill from URL (?q=...&style=...) or component default.
  const params = new URLSearchParams(window.location.search);
  if (params.get('q')) promptEl.value = params.get('q');
  else if (defaultPrompt) promptEl.value = defaultPrompt;
  if (params.get('style') && STYLE_PALETTES[params.get('style')]) setStyle(params.get('style'));
  else if (defaultStyle && STYLE_PALETTES[defaultStyle]) setStyle(defaultStyle);
  updatePreview();

  // First paint: free printable nets (no API cost). If arriving with a pre-filled idea,
  // run real generation right away.
  if (params.get('q')) generate();
  else generateFallback();
</script>
