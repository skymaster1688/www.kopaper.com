---
interface Props {
  defaultStyle?: 'cute' | 'lowpoly' | 'pixel' | 'fantasy' | 'minecraft';
  defaultPrompt?: string;
}
const { defaultStyle = 'cute', defaultPrompt = '' } = Astro.props;

const STYLES = [
  { id: 'cute', label: 'Cute', hint: 'round kawaii forms', tone: 'mint' },
  { id: 'lowpoly', label: 'Low Poly', hint: 'geometric facets', tone: 'blue' },
  { id: 'pixel', label: 'Pixel', hint: '8-bit sprite', tone: 'peach' },
  { id: 'fantasy', label: 'Fantasy', hint: 'magical glow', tone: 'lilac' },
  { id: 'minecraft', label: 'Blocky', hint: 'chunky voxel cubes', tone: 'lemon' },
];
const QUICK_IDEAS = ['a cute panda', 'a low poly fox', 'a fantasy castle', 'a pixel heart'];
---

<!-- 728x90 banner ad (highrevenueformat), sits above the generator input -->
<div style="margin:0 auto 18px;max-width:728px;min-height:90px;display:flex;align-items:center;justify-content:center;padding:0;box-sizing:border-box;">
  <script is:inline>
    atOptions = {
      'key' : '39da9af78b31d91aa67016760fb128ed',
      'format' : 'iframe',
      'height' : 90,
      'width' : 728,
      'params' : {}
    };
  </script>
  <script is:inline src="https://www.highrevenueformat.com/39da9af78b31d91aa67016760fb128ed/invoke.js"></script>
</div>

<!-- Generator app — reusable on /tools/<style>/ pages. Visual language mirrors
     the homepage generator card (cream/purple, rounded, pill buttons). -->
<section class="pgen reveal" aria-label="Papercraft generator" data-default-style={defaultStyle} data-default-prompt={defaultPrompt}>
  <div class="pgen-main">
    <label class="pgen-label" for="prompt">What would you like to create?</label>
    <textarea id="prompt" rows="4" maxlength="400" placeholder="A tiny orange fox sitting in a flower garden, made from folded paper..." autocomplete="off"></textarea>
    <div class="pgen-quick" aria-label="Quick prompt ideas">
      <span class="pgen-quick-label">Try:</span>
      {QUICK_IDEAS.map((q) => (
        <button type="button" class="pgen-chip" data-idea={q}>{q}</button>
      ))}
    </div>
    <div class="pgen-styles-label">Choose a paper style <span>adds a papercraft look</span></div>
    <div class="pgen-chiprow" id="styleChips" role="group" aria-label="Style">
      {STYLES.map((s) => (
        <button type="button" class:list={['pgen-style', s.tone]} data-style={s.id} aria-pressed={s.id === defaultStyle}>
          {s.label}<span>{s.hint}</span>
        </button>
      ))}
    </div>
    <div class="pgen-actions">
      <button class="pgen-btn ghost" id="polishBtn" type="button" title="Expand and clean up your idea">✨ AI polish</button>
      <button class="pgen-btn ghost" id="surprise" type="button">🎲 Surprise me</button>
      <button class="pgen-btn primary" id="generateBtn" type="button">✦ Generate Design <span>→</span></button>
    </div>
    <div class="pgen-foot"><span><span class="pgen-spark">✦</span> Be as imaginative as you like</span></div>
    <p class="pgen-preview" id="promptPreview" aria-live="polite"></p>
  </div>

  <aside class="pgen-aside">
    <div class="pgen-art">
      <div class="pa-sun"></div><div class="pa-butterfly">🦋</div>
      <div class="pa-flower">🌼</div>
      <div class="pa-hill"></div><div class="pa-hill second"></div>
    </div>
    <h3>A blank page full of possibilities.</h3>
    <p>Start with a simple idea. Refine your prompt and explore different looks as you go.</p>
    <span class="pgen-tip">IDEA TIP <b>Try "a sleepy cat in a teacup"</b></span>
  </aside>

  <div class="pgen-stage">
    <div class="pgen-frame">
      <div class="result-grid" id="resultGrid">
        <div class="gen-empty" data-empty>
          <img class="gen-empty-img" src="/assets/ai/gen-fox.jpg" alt="Example papercraft fox design" width="360" height="360" loading="eager" decoding="async" />
          <h3 class="gen-empty-title">Turn any idea into papercraft</h3>
          <p class="gen-empty-sub">Type what you imagine, pick a style, and hit <em>Generate Design</em>.</p>
        </div>
      </div>
    </div>
    <div class="pgen-loading" id="genLoading" hidden>
      <div class="spinner" aria-hidden="true"></div>
      <p id="genStatus">Planning content elements…</p>
    </div>
  </div>
</section>

<style>
  /* --- card shell (mirrors the homepage .generator-card) --- */
  .pgen { display: grid; grid-template-columns: 1.35fr .65fr; gap: 22px; background: #fff; border: 1px solid #f0eae5; border-radius: 25px; padding: 28px; box-shadow: 0 18px 55px rgba(102, 81, 61, .05); }
  .pgen-stage { grid-column: 1 / -1; position: relative; }
  .pgen-frame { background: #fdfcff; border: 1px solid #f0eae5; border-radius: 18px; min-height: 480px; padding: 20px; display: flex; align-items: center; justify-content: center; }

  /* --- prompt --- */
  .pgen-label { display: block; font-size: 13px; font-weight: 800; margin-bottom: 10px; color: var(--text); }
  .pgen textarea { width: 100%; height: 110px; resize: vertical; border: 1px solid #e9e3ee; border-radius: 14px; padding: 14px; font: inherit; font-size: 14px; line-height: 1.6; outline: none; background: #fdfcff; color: var(--text); transition: border-color .2s, box-shadow .2s; }
  .pgen textarea:focus { border-color: var(--warm); box-shadow: 0 0 0 3px rgba(118, 80, 233, .10); }
  .pgen-quick { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .pgen-quick-label { font-size: 12px; font-weight: 700; color: var(--text-muted); }
  .pgen-chip { border: 1px solid var(--border); background: #fff; border-radius: 30px; padding: 7px 13px; font: inherit; font-size: 12.5px; font-weight: 700; color: var(--text); cursor: pointer; transition: border-color .2s, color .2s, transform .2s; }
  .pgen-chip:hover { border-color: var(--warm); color: var(--warm); transform: translateY(-1px); }

  /* --- style pills --- */
  .pgen-styles-label { font-size: 13px; font-weight: 800; margin: 16px 0 10px; color: var(--text); }
  .pgen-styles-label span { font-weight: 400; color: var(--text-muted); font-size: .78rem; margin-left: 4px; }
  .pgen-chiprow { display: flex; flex-wrap: wrap; gap: 8px; }
  .pgen-style { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 9px 14px; border: 1px solid var(--border); border-radius: 14px; background: #fff; color: var(--text); font: inherit; font-size: .9rem; font-weight: 700; cursor: pointer; text-align: left; transition: border-color .15s, background .15s, transform .15s; }
  .pgen-style span { font-size: .72rem; font-weight: 400; color: var(--text-muted); }
  .pgen-style:hover { transform: translateY(-1px); border-color: #d9cff5; }
  .pgen-style[aria-pressed="true"] { border-color: var(--warm); background: var(--warm-soft); }
  .pgen-style[aria-pressed="true"] span { color: var(--warm); }

  /* --- actions --- */
  .pgen-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .pgen-btn { border: 0; border-radius: 30px; padding: 12px 20px; font: inherit; font-weight: 800; font-size: 14px; cursor: pointer; display: inline-flex; align-items: center; gap: 9px; transition: transform .2s, background .2s, box-shadow .2s, border-color .2s, color .2s; }
  .pgen-btn.ghost { background: #fff; border: 1px solid var(--border); color: var(--text); }
  .pgen-btn.ghost:hover { border-color: var(--warm); color: var(--warm); }
  .pgen-btn.primary { background: var(--warm); color: #fff; box-shadow: 0 8px 18px rgba(118, 80, 233, .2); padding: 12px 24px; }
  .pgen-btn.primary:hover { background: var(--warm-dark); transform: translateY(-2px); }
  .pgen-btn:disabled { opacity: .6; cursor: wait; transform: none; }
  .pgen-foot { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--text-muted); margin-top: 12px; }
  .pgen-spark { color: var(--warm); }
  .pgen-preview { margin: 8px 0 0; font-size: .78rem; line-height: 1.5; color: var(--text-muted); font-family: var(--font-mono); background: var(--warm-soft); border-radius: 10px; padding: 8px 10px; word-break: break-word; }

  /* --- aside (mirrors the homepage generator-aside) --- */
  .pgen-aside { border-radius: 18px; background: #f5efff; padding: 18px; display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .pgen-art { height: 150px; border-radius: 13px; background: linear-gradient(140deg, #d9e9ff, #fce6d9); position: relative; overflow: hidden; display: grid; place-items: center; }
  .pa-sun { position: absolute; top: 14px; right: 16px; width: 38px; height: 38px; border-radius: 50%; background: #ffd98a; }
  .pa-butterfly { font-size: 20px; position: absolute; top: 20px; left: 22%; }
  .pa-flower { font-size: 22px; position: absolute; left: 16px; bottom: 12px; z-index: 1; }
  .pa-hill { position: absolute; bottom: -26px; left: -10%; width: 70%; height: 56px; border-radius: 50%; background: #bfe3c8; }
  .pa-hill.second { left: 45%; background: #a8d9b5; }
  .pgen-aside h3 { margin: 6px 0 0; font-size: 15px; font-weight: 800; color: var(--text); }
  .pgen-aside p { margin: 0; font-size: 12.5px; line-height: 1.6; color: var(--text-muted); }
  .pgen-tip { font-size: 9px; letter-spacing: 1px; color: #9874e9; margin-top: 12px; font-weight: 800; }
  .pgen-tip b { display: block; margin-top: 3px; font-size: 12px; letter-spacing: 0; color: var(--text); }

  /* --- stage states --- */
  .pgen-loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; color: var(--text-muted); background: rgba(253, 252, 255, .92); border-radius: 18px; z-index: 2; }
  .pgen-loading[hidden] { display: none; }
  .pgen-loading p { font-size: 1.05rem; }
  .pgen-loading .spinner { width: 36px; height: 36px; border: 3px solid var(--border); border-top-color: var(--warm); border-radius: 50%; animation: pgen-spin .9s linear infinite; }
  @keyframes pgen-spin { to { transform: rotate(360deg); } }
  .gen-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; text-align: center; padding: 18px 14px; max-width: 540px; margin: 0 auto; }
  .gen-empty-img { width: min(56%, 380px); border-radius: 18px; border: 1px solid var(--border); box-shadow: 0 14px 34px rgba(15, 23, 42, .12); background: #fff; }
  .gen-empty-title { margin: 14px 0 0; font-size: 1.3rem; font-weight: 700; color: var(--text); }
  .gen-empty-sub { margin: 0; font-size: .95rem; color: var(--text-muted); line-height: 1.6; max-width: 380px; }
  .gen-empty-sub em { font-style: normal; color: var(--warm); font-weight: 600; }

  @media (max-width: 900px) { .pgen { grid-template-columns: 1fr; padding: 18px; border-radius: 20px; } .pgen-stage { grid-column: auto; } .pgen-frame { min-height: 380px; } }
</style>

<script>
  import { pickDirections } from '../lib/directions';
  // Read component defaults from data attributes instead of define:vars.
  // define:vars forces inline scripts, and an inline <script> cannot use `import`
  // (browser throws "Cannot use import statement outside a module"), which killed
  // every button handler on this page.
  const genApp = document.querySelector('.pgen');
  const defaultStyle = (genApp && genApp.dataset.defaultStyle) || 'cute';
  const defaultPrompt = (genApp && genApp.dataset.defaultPrompt) || '';
  // Monochrome line-art output: white paper, ink lines (printable + on-brand).
  const STYLE_PALETTES = {
    cute:    ['#FFFFFF', '#0A0A0B'],
    lowpoly: ['#FFFFFF', '#0A0A0B'],
    pixel:   ['#FFFFFF', '#0A0A0B'],
    fantasy: ['#FFFFFF', '#0A0A0B'],
    minecraft: ['#FFFFFF', '#0A0A0B'],
  };
  // Style phrases injected into the prompt so "style" is a real hint, not just a label.
  const STYLE_PHRASES = {
    cute: 'cute kawaii',
    lowpoly: 'low poly geometric',
    pixel: 'pixel art',
    fantasy: 'fantasy magical',
    minecraft: 'blocky voxel cube',
  };
  // Fixed papercraft anchor — kept in sync with the server-side buildPrompt so the
  // preview mirrors what the model actually receives.
  const PROMPT_TAIL = 'paper art sculpture, papercraft design, clean light background, high detail';

  const $ = (id) => document.getElementById(id);
  const promptEl = $('prompt');
  const styleChips = $('styleChips');
  const polishBtn = $('polishBtn');
  const promptPreview = $('promptPreview');

  function getStyle() {
    const sel = styleChips && styleChips.querySelector('.pgen-style[aria-pressed="true"]');
    return sel ? sel.dataset.style : (defaultStyle || 'cute');
  }
  function setStyle(style) {
    if (!styleChips) return;
    styleChips.querySelectorAll('.pgen-style').forEach(c => {
      c.setAttribute('aria-pressed', String(c.dataset.style === style));
    });
    updatePreview();
  }
  // Live preview of the exact prompt the model will receive: fixed base + user input + style phrase.
  function updatePreview() {
    if (!promptPreview) return;
    const idea = promptEl.value.trim();
    const phrase = STYLE_PHRASES[getStyle()] || STYLE_PHRASES.cute;
    const shown = idea || 'your idea';
    promptPreview.textContent = `${phrase} papercraft of ${shown}, ${PROMPT_TAIL}`;
  }
  // Heuristic, free "AI polish": trims filler, drops leading articles/commands,
  // capitalizes, and de-duplicates words so a rough idea reads like a clean prompt.
  function polishPrompt(text) {
    let t = text.trim().replace(/\s+/g, ' ');
    t = t.replace(/^(please\s+)?(make|create|generate|give me|i want|i need|a|an|the|some)\s+/i, '');
    if (t) t = t.charAt(0).toUpperCase() + t.slice(1);
    const seen = new Set();
    const uniq = t.split(' ').filter(Boolean).filter(w => {
      const k = w.toLowerCase();
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    });
    return uniq.join(' ');
  }

  function pickFromPrompt(text) {
    const q = text.toLowerCase();
    if (/(person|man|woman|boy|girl|child|kid|people|teacher|doctor|astronaut|soldier|player|character|human|face|head)/.test(q)) return 'person';
    if (/(animal|fox|cat|dog|bear|panda|rabbit|lion|tiger|elephant|bird|fish|owl|deer|wolf|monkey|frog|turtle|butterfly|dragon|unicorn)/.test(q)) return 'animal';
    if (/(castle|spaceship|spacecraft|rocket|ship|boat|airplane|plane|ufo|alien|monster|fairy|wizard|magic|fantasy|dream|future|sci-fi|scifi|mecha|giant)/.test(q)) return 'fantasy';
    if (/(pen|pencil|book|desk|eraser|ruler|notebook|paper|stationery|school|ball|bat|racket|helmet|whistle|basketball|football|soccer|tennis|baseball|sport|cup|bottle|clock|phone|camera|lamp|chair|table|guitar|piano|umbrella|hat|shoe|bag|gift|box|toy|car|truck|bike|bicycle|train|bus)/.test(q)) return 'object';
    return null;
  }

  let currentSVGs = [];
  let currentImages = [];
  let currentDirs = [];

  const GEN_STATUS = [
    'Planning content elements…',
    'Generating style…',
    'Refining image details…',
    'Rendering final look…',
    'Finalizing details…',
    'Finalizing style…',
  ];
  let statusTimer = null;
  let statusIdx = 0;
  function startStatus() {
    const el = $('genStatus');
    if (!el) return;
    statusIdx = 0;
    el.textContent = GEN_STATUS[0];
    if (statusTimer) clearInterval(statusTimer);
    statusTimer = setInterval(() => {
      statusIdx = Math.min(statusIdx + 1, GEN_STATUS.length - 1);
      el.textContent = GEN_STATUS[statusIdx];
    }, 2500);
  }
  function stopStatus() {
    if (statusTimer) { clearInterval(statusTimer); statusTimer = null; }
  }

  function setLoading(on) {
    const btn = $('generateBtn');
    if (btn) { btn.disabled = on; btn.innerHTML = on ? '✦ Generating…' : '✦ Generate Design <span>→</span>'; }
    const grid = $('resultGrid');
    if (grid) grid.classList.toggle('loading', on);
    const loading = $('genLoading');
    if (loading) loading.hidden = !on;
    if (on) startStatus(); else stopStatus();
  }

  // Render the grid: one main card with the generated image, plus a directions
  // panel with 3-5 text suggestions. No templated filler text.
  function renderResult(img, dirs) {
    const grid = $('resultGrid');
    if (!grid) return;
    grid.innerHTML = '';
    const main = document.createElement('div');
    main.className = 'result-card';
    main.innerHTML =
      '<div class="thumb">' +
        (img && img.b64
          ? '<img class="gen-img" alt="Your papercraft design" src="data:' + img.mediaType + ';base64,' + img.b64 + '" loading="lazy" decoding="async">'
          : '<img class="gen-img" alt="Your papercraft design" src="' + img.src + '" width="400" height="400" loading="lazy" decoding="async">') +
      '</div>' +
      '<div class="meta"><span class="title">Your design</span>' +
      '<span class="actions"><button type="button" class="mini" data-i="0">Download</button></span></div>';
    grid.appendChild(main);
    main.querySelector('.mini').addEventListener('click', () => downloadAsset(0));
    const panel = document.createElement('div');
    panel.className = 'dir-panel';
    panel.innerHTML =
      '<h3 class="dir-heading">Ways to take it further</h3>' +
      '<ul class="dir-list">' +
      dirs.map((d) => '<li class="dir-item"><span class="dir-tag">' + d.title + '</span><p>' + (d.prompt || d.hint) + '</p></li>').join('') +
      '</ul>';
    grid.appendChild(panel);
  }

  // Ensure the loading state shows long enough for the fake progress cycle
  // (6 steps x 2500ms) to feel deliberate, even when the API answers fast.
  function minDelay(start, ms = 2500 * GEN_STATUS.length) {
    return new Promise((resolve) => {
      const wait = Math.max(0, ms - (Date.now() - start));
      setTimeout(resolve, wait);
    });
  }

  // Real AI generation: keep the user's own prompt for the image, then show it
  // alongside 3-5 direction suggestions as content.
  async function generate() {
    const q = promptEl.value.trim() || 'a papercraft';
    const style = getStyle();
    const start = Date.now();
    setLoading(true);
    const dirs = pickDirections(q);
    let ok = false;
    try {
      const res = await fetch('/api/generate-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt: q, style, n: 1 }),
      });
      if (res.ok) {
        const data = await res.json();
        if (data && data.ok && data.images && data.images.length) {
          const aiDirs = (data.directions && data.directions.length) ? data.directions : dirs;
          currentImages = data.images;
          currentSVGs = [];
          currentDirs = aiDirs.map((d) => d.title);
          renderResult(data.images[0], aiDirs);
          ok = true;
        }
      }
    } catch (_) { /* fall through to fallback image */ }
    if (!ok) generateFallback(dirs);
    await minDelay(start);
    setLoading(false);
    if (ok) autoPublish();
  }

  // Fallback when the API is unavailable: reuse the pre-generated AI category
  // image for the main card, still with the direction suggestions as content.
  function generateFallback(dirs) {
    const q = promptEl.value.trim();
    const matched = pickFromPrompt(q);
    const base = matched || 'object';
    const imgMap = {
      object: '/assets/ai/cat-object.jpg',
      person: '/assets/ai/cat-person.jpg',
      animal: '/assets/ai/cat-animal.jpg',
      fantasy: '/assets/ai/cat-fantasy.jpg',
    };
    const list = (dirs && dirs.length ? dirs : pickDirections(q || 'a papercraft'));
    currentSVGs = [];
    currentImages = [];
    renderResult({ src: imgMap[base] }, list);
  }

  function surprise() {
    const styles = Object.keys(STYLE_PALETTES);
    setStyle(styles[Math.floor(Math.random() * styles.length)]);
    const ideas = ['a cute panda', 'a fantasy castle', 'a robot toy', 'a gift box', 'a paper fortune teller', 'a low poly pyramid'];
    promptEl.value = ideas[Math.floor(Math.random() * ideas.length)];
    updatePreview();
    generate();
  }

  function downloadAsset(i) {
    const img = currentImages[i];
    if (img && img.b64) {
      const a = document.createElement('a');
      a.href = `data:${img.mediaType};base64,${img.b64}`;
      a.download = `kopaper-design-${i + 1}.png`;
      a.click();
      return;
    }
    const data = currentSVGs[i];
    if (!data) return;
    const blob = new Blob(['<?xml version="1.0" encoding="UTF-8"?>\n' + data], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `kopaper-design-${i + 1}.svg`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // Stage the current design into the daily Gallery queue (KV) in the background.
  // Best-effort: failures are silent so they never interrupt the user. The queue
  // is flushed to the live site once per day via /api/publish-flush (one deploy).
  async function autoPublish() {
    // Only queue designs with a real idea — skip placeholder/empty prompts so
    // exploratory generates don't flood the daily Gallery queue.
    const raw = promptEl.value.trim();
    if (!raw || raw.toLowerCase() === 'a papercraft') return;
    const style = getStyle();
    const img = currentImages[0];
    const svg = currentSVGs[0];
    // The AI image is generated from the FULL prompt, but the Gallery title/meta
    // should be a short, clean subject (first clause). This keeps long cinematic
    // prompts from overflowing the queue char limit or producing garbled titles.
    const subject = raw.split(/[,.]/)[0].trim() || raw;
    const payload = { prompt: subject, style };
    if (img && img.b64) {
      Object.assign(payload, { kind: 'raster', b64: img.b64, mediaType: img.mediaType });
    } else if (svg) {
      Object.assign(payload, { kind: 'svg', svg });
    } else {
      return;
    }
    try {
      const r = await fetch('/api/publish-queue', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!r.ok) {
        let msg = '';
        try { msg = (await r.json()).error || ''; } catch (_) { /* ignore */ }
        console.warn('[koPaper] gallery queue rejected:', r.status, msg);
      }
    } catch (_) { /* queue is best-effort; network errors are non-fatal */ }
  }

  // Wire events
  $('generateBtn').addEventListener('click', generate);
  $('surprise').addEventListener('click', surprise);
  // Style pills select a look (updates the preview) but do NOT auto-generate.
  if (styleChips) styleChips.addEventListener('click', (e) => {
    const btn = e.target.closest('.pgen-style');
    if (!btn) return;
    setStyle(btn.dataset.style);
  });
  // AI polish: expand/clean the idea in place, then refresh the preview (no generate).
  if (polishBtn) polishBtn.addEventListener('click', () => {
    const p = polishPrompt(promptEl.value);
    if (p) promptEl.value = p;
    updatePreview();
  });
  promptEl.addEventListener('input', updatePreview);
  // Quick-idea chips: fill the prompt and focus (same interaction as the homepage).
  document.querySelectorAll('.pgen-chip').forEach((c) => {
    c.addEventListener('click', () => {
      promptEl.value = c.dataset.idea || '';
      updatePreview();
      promptEl.focus();
    });
  });

  // Prefill from URL (?q=...&style=...) or component default.
  const params = new URLSearchParams(window.location.search);
  if (params.get('q')) promptEl.value = params.get('q');
  else if (defaultPrompt) promptEl.value = defaultPrompt;
  if (params.get('style') && STYLE_PALETTES[params.get('style')]) setStyle(params.get('style'));
  else if (defaultStyle && STYLE_PALETTES[defaultStyle]) setStyle(defaultStyle);
  updatePreview();

  // If arriving with a pre-filled idea via URL (?q=...), run generation right away.
  // Otherwise keep the friendly empty-state guide until the user hits Generate.
  if (params.get('q')) generate();
</script>
