---
const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'Generator', href: '/tools/', match: '/tools' },
  { label: 'Crafts', href: '/origami/', match: '/origami' },
  { label: 'Gallery', href: '/gallery/', match: '/gallery' },
  { label: 'Learn', href: '/learn/', match: '/learn' },
  { label: 'About', href: '/about/', match: '/about' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="mk"></span>
      koPaper
    </a>

    <nav class="nav-links" id="navLinks">
      {navItems.map(item => (
        <a href={item.href} class={currentPath.startsWith(item.match) ? 'active' : ''}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="theme-btn" id="themeToggle" aria-label="Toggle theme">&#127769;</button>
      <a href="/" class="btn btn-primary">Open Generator &rarr;</a>
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu">&#9776;</button>
    </div>
  </div>
</header>
