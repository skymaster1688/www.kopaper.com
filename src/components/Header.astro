---
const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'Crafts', href: '/origami/', match: '/origami' },
  { label: 'Templates', href: '/templates/', match: '/templates' },
  { label: 'Letter Paper', href: '/letter-paper/', match: '/letter-paper' },
  { label: 'Text Compare', href: '/text-compare/', match: '/text-compare' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-icon">&#128220;</span>
      koPaper
    </a>

    <nav class="nav-links" id="navLinks">
      {navItems.map(item => (
        <a href={item.href} class={currentPath.startsWith(item.match) ? 'active' : ''}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="theme-btn" id="themeToggle" aria-label="Toggle theme">&#127769;</button>
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu">&#9776;</button>
    </div>
  </div>
</header>
