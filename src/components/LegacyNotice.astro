---
interface Props {
  title: string;
  intro: string;
  badge?: string;
  links?: { href: string; label: string }[];
}
const {
  title,
  intro,
  badge = 'koPaper has evolved',
  links = [
    { href: '/tools/papercraft-generator/', label: 'AI Papercraft Generator' },
    { href: '/origami/', label: 'Origami Tutorials' },
    { href: '/', label: 'Back to home' },
  ],
} = Astro.props;
---

<section class="legacy">
  <div class="legacy-inner">
    <span class="badge">{badge}</span>
    <h1 class="display">{title}</h1>
    <p class="lead">{intro}</p>
    <div class="legacy-links">
      {links.map((l) => (
        <a class="ecard" href={l.href}>
          <span class="ecard-title">{l.label}</span>
          <span class="ecard-arrow">&rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .legacy { padding: 88px 0 110px; }
  .legacy-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }
  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--warm);
    border: 1px solid var(--warm);
    border-radius: 999px;
    padding: 4px 13px;
    margin-bottom: 24px;
  }
  .display {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    margin: 0 0 18px;
    line-height: 1.08;
  }
  .lead {
    color: var(--text-muted);
    font-size: 1.06rem;
    line-height: 1.7;
    margin: 0 auto 40px;
    max-width: 56ch;
  }
  .legacy-links {
    display: grid;
    gap: 14px;
    max-width: 460px;
    margin: 0 auto;
  }
  .ecard {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    background: var(--surface);
    transition: border-color .15s, transform .15s;
  }
  .ecard:hover { border-color: var(--text); transform: translateY(-2px); }
  .ecard-title { font-weight: 600; }
  .ecard-arrow { color: var(--warm); font-weight: 700; }
</style>
